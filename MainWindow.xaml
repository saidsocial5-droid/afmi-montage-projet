<Window x:Class="AFMI_Montage_projet_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AFMI_Montage_projet_2"
        xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
        xmlns:views="clr-namespace:AFMI_Montage_projet_2.Views"
        mc:Ignorable="d"
        Title="AFMI - Montage et Dossiers de Projets Associatifs"
        Icon="/app_icon.ico"
        Height="768" Width="1024"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:ProjectListViewModel}">
            <views:ProjectListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProjectWorkspaceViewModel}">
            <views:ProjectWorkspaceView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
