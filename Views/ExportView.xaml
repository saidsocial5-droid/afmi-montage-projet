<UserControl x:Class="AFMI_Montage_projet_2.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
             xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
             xmlns:converters="clr-namespace:AFMI_Montage_projet_2.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>


    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="60"/>
            <!-- Contenu des exports -->
            <RowDefinition Height="*"/>
            <!-- Pied de page -->
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="15,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Génération &amp; Exports de Documents" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Générez vos dossiers de projet aux formats attendus par les bailleurs de fonds." Foreground="#64748B" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Contenu des exports -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Export Excel -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="25" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🟢 BUDGET EXCEL" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="1" Text="Matrice Budgétaire" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="2" Text="Génère un classeur Excel complet (.xlsx) contenant les lignes budgétaires regroupées par rubriques. Le fichier conserve les formules de calcul actives pour que les bailleurs puissent auditer le budget." 
                                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,15"/>

                            <Button Grid.Row="3" Content="Exporter en Excel (.xlsx)" Command="{Binding ExportExcelCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="38" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Export Word -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="25" Margin="10,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🔵 PROPOSITION WORD" FontSize="16" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="1" Text="Dossier de projet éditable" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="2" Text="Génère un document Word (.docx) professionnel avec une page de garde, la note conceptuelle rédigée (contexte, objectifs) et le tableau du cadre logique complet inséré de manière structurée." 
                                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,15"/>

                            <Button Grid.Row="3" Content="Exporter en Word (.docx)" Command="{Binding ExportWordCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="38" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Export PDF -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="25" Margin="10,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🔴 DOSSIER COMPLET PDF" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="1" Text="Document final prêt à soumettre" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="2" Text="Compile l'intégralité du projet en un fichier PDF (.pdf) non modifiable au design moderne. Inclut la fiche d'identité du projet, les arguments de justification, les objectifs spécifiques, le cadre logique et la synthèse du budget." 
                                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,15"/>

                            <Button Grid.Row="3" Content="Exporter en PDF (.pdf)" Command="{Binding ExportPdfCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="38" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Carte Institutionnelle : Profil ONG & Déclaration de Capacité Bailleurs -->
                <Border Background="White" CornerRadius="8" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🏛️ FICHE INSTITUTIONNELLE &amp; CAPACITÉS DE L'ASSOCIATION (AFMI)" FontSize="15" FontWeight="Bold" Foreground="#4338CA"/>
                                <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="Annexe Obligatoire Bailleurs" Foreground="#4338CA" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Document officiel présentant l'identité juridique, la gouvernance, les réalisations passées (track record), les capacités fiduciaires et la déclaration de capacité institutionnelle exigée par l'UE, l'AFD, le PNUD et la Banque Mondiale." 
                                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" MaxWidth="680"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                            <Button Content="📄 Profil ONG (Word)" Command="{Binding ExportProfileWordCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="38" Background="#4338CA" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="15,0" Margin="0,0,10,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Content="📑 Profil ONG (PDF)" Command="{Binding ExportProfilePdfCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="38" Background="#6366F1" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="15,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pied de page -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

