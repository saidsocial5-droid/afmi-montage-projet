<Window x:Class="AFMI_Montage_projet_2.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour disponible" Height="460" Width="620" MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="TxtVersions" Foreground="#475569" Margin="0,4,0,0"/>
            <TextBlock Text="Vos projets et réglages sont conservés : seule l'application est remplacée. Une sauvegarde de la base est faite au redémarrage."
                       Foreground="#047857" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="Nouveautés" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNotes" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Background="White" BorderBrush="#E2E8F0"/>
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" Height="8" Maximum="1" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtStatus" Foreground="#0369A1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnGitHub" Content="Voir sur GitHub" Click="BtnGitHub_Click" Padding="12,7" Margin="0,0,8,0" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="BtnLater" Content="Plus tard" Click="BtnLater_Click" Padding="14,7" Margin="0,0,8,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="BtnInstall" Content="⬇ Installer maintenant" Click="BtnInstall_Click" Padding="14,7" Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
