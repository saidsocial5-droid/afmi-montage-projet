<Window x:Class="AFMI_Montage_projet_2.Views.CanvasDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
        mc:Ignorable="d"
        Title="Concepteur de Canevas Bailleur - AFMI" Height="720" Width="950"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. En-tête -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect><DropShadowEffect BlurRadius="8" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
            <StackPanel>
                <TextBlock Text="🛠️ Créateur Manuel de Canevas Bailleur" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                <TextBlock Text="Créez des sections et des blocs de questions avec leurs zones de réponses sur-mesure." 
                           Foreground="#64748B" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 2. Informations du Canevas -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect><DropShadowEffect BlurRadius="8" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Nom du Canevas (ex: Canevas FEM 2026) :" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CanvasName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Description / Note d'orientation :" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CanvasDescription, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Liste des Sections et Questions -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <!-- Titre de section + Actions -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁 Section :" FontWeight="Bold" FontSize="14" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding SectionTitle, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="14" Width="450" Height="32" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="➕ Ajouter Question" Command="{Binding AddQuestionCommand}" 
                                                Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="🗑️" Command="{Binding DataContext.RemoveSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Background="#EF4444" Foreground="White" Width="32" Height="32" Cursor="Hand" BorderThickness="0" ToolTip="Supprimer cette section">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Questions de la section -->
                                <ItemsControl ItemsSource="{Binding Questions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#CBD5E1" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Libellé de la question -->
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="❓ Libellé de la question / Exigence du bailleur :" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1"/>
                                                    </StackPanel>

                                                    <!-- Type de réponse -->
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                                                        <TextBlock Text="Type de zone de réponse :" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                                        <ComboBox SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="30" VerticalContentAlignment="Center">
                                                            <ComboBoxItem Content="📝 Paragraphe long (TextLong)" Tag="TextLong" IsSelected="True"/>
                                                            <ComboBoxItem Content="📄 Ligne courte (TextShort)" Tag="TextShort"/>
                                                            <ComboBoxItem Content="📋 Choix déroulant (Dropdown)" Tag="Dropdown"/>
                                                            <ComboBoxItem Content="☑️ Case à cocher (Checkbox)" Tag="Checkbox"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Bouton Supprimer Question -->
                                                    <Button Grid.Row="0" Grid.Column="2" Content="✕" 
                                                            Command="{Binding DataContext.RemoveQuestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" Width="28" Height="28" VerticalAlignment="Bottom" Margin="0,0,0,1" Cursor="Hand" BorderThickness="0" ToolTip="Supprimer cette question">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>

                                                    <!-- Options si type Dropdown -->
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                                        <TextBlock Text="Options du menu déroulant (séparées par des virgules) :" FontSize="10" Foreground="#64748B"/>
                                                        <TextBox Text="{Binding OptionsCommaSeparated, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0" BorderBrush="#CBD5E1"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. Barre d'action finale -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15">
            <Border.Effect><DropShadowEffect BlurRadius="8" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="➕ Ajouter une autre section" Command="{Binding AddSectionCommand}"
                        Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Padding="14,8" Cursor="Hand" BorderBrush="#CBD5E1" BorderThickness="1">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Annuler" Click="Annuler_Click"
                            Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Width="100" Height="36" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>

                    <Button Content="💾 Enregistrer le Canevas" Command="{Binding SaveCanvasCommand}"
                            Background="#16A34A" Foreground="White" FontWeight="Bold" Width="180" Height="36" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
