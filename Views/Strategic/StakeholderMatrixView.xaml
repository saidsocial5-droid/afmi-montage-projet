<UserControl x:Class="AFMI_Montage_projet_2.Views.Strategic.StakeholderMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="600">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre de la matrice -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Matrice Pouvoir / Intérêt des Parties Prenantes (Power/Interest Matrix)" 
                           FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Répartition dynamique des acteurs selon leur degré d'influence et d'intérêt" 
                           FontSize="11" Foreground="#64748B"/>
            </StackPanel>

            <!-- Grille 2x2 des 4 quadrants -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Quadrant 1 (Haut-Gauche): Pouvoir Fort / Intérêt Faible (Maintenir Satisfait) -->
                <Border Grid.Row="0" Grid.Column="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
                    <Grid>
                        <TextBlock Text="Maintenir Satisfait (Pouvoir Fort / Intérêt Faible)" 
                                   FontWeight="Bold" FontSize="11" Foreground="#B45309" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <ListBox ItemsSource="{Binding Stakeholders}" Margin="0,22,0,0" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="4" Padding="6,3" Margin="0,2" BorderBrush="#FDE68A" BorderThickness="1">
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#78350F"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Quadrant 2 (Haut-Droite): Pouvoir Fort / Intérêt Fort (Collaborer Étroitement) -->
                <Border Grid.Row="0" Grid.Column="1" Background="#DCFCE7" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
                    <Grid>
                        <TextBlock Text="Collaborer Étroitement (Pouvoir Fort / Intérêt Fort)" 
                                   FontWeight="Bold" FontSize="11" Foreground="#047857" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <ListBox ItemsSource="{Binding Stakeholders}" Margin="0,22,0,0" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="4" Padding="6,3" Margin="0,2" BorderBrush="#A7F3D0" BorderThickness="1">
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#064E3B"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Quadrant 3 (Bas-Gauche): Pouvoir Faible / Intérêt Faible (Surveiller) -->
                <Border Grid.Row="1" Grid.Column="0" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
                    <Grid>
                        <TextBlock Text="Surveiller (Pouvoir Faible / Intérêt Faible)" 
                                   FontWeight="Bold" FontSize="11" Foreground="#475569" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <ListBox ItemsSource="{Binding Stakeholders}" Margin="0,22,0,0" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="4" Padding="6,3" Margin="0,2" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Quadrant 4 (Bas-Droite): Pouvoir Faible / Intérêt Fort (Tenir Informé) -->
                <Border Grid.Row="1" Grid.Column="1" Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
                    <Grid>
                        <TextBlock Text="Tenir Informé (Pouvoir Faible / Intérêt Fort)" 
                                   FontWeight="Bold" FontSize="11" Foreground="#0369A1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <ListBox ItemsSource="{Binding Stakeholders}" Margin="0,22,0,0" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="4" Padding="6,3" Margin="0,2" BorderBrush="#BAE6FD" BorderThickness="1">
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#0C4A6E"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
