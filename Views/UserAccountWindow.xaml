<Window x:Class="AFMI_Montage_projet_2.Views.UserAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
        xmlns:helpers="clr-namespace:AFMI_Montage_projet_2.Helpers"
        Title="Gérer mon compte personnel" 
        Icon="/app_icon.ico"
        Height="450" Width="400"
        WindowStartupLocation="CenterScreen" 
        Background="#F8FAFC">
    
    <Window.DataContext>
        <viewmodels:UserAccountViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Mon Compte Personnel" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20" />
            
            <TextBlock Text="Nom d'utilisateur" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,15" />

            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,15" />

            <TextBlock Text="Nouveau mot de passe (laisser vide pour ne pas changer)" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" TextWrapping="Wrap"/>
            <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Mot de passe confidentiel" Padding="8" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,20" />

            <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />

            <Button Content="Enregistrer les modifications" Command="{Binding SaveCommand}" 
                    Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" Padding="10" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
