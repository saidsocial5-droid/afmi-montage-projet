<UserControl x:Class="AFMI_Montage_projet_2.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
             xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">

    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <!-- Actions et infos -->
            <RowDefinition Height="Auto"/>
            <!-- Alerte de dépassement -->
            <RowDefinition Height="Auto"/>
            <!-- Onglets principaux -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Actions et infos -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="💰 Budget Prévisionnel &amp; Cofinancement" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Configurez les contributions multi-sources et contrôlez la répartition financière de votre projet." Foreground="#64748B" FontSize="11"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Enregistrer le Budget" Command="{Binding SaveBudgetCommand}"
                        Background="#10B981" Foreground="White" FontWeight="Bold" Width="180" Height="35"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Alerte de dépassement -->
        <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1" Padding="15,8"
                Visibility="{Binding AlertMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding AlertMessage}" Foreground="#991B1B" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Onglets principaux -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="10,10,10,10">
            
            <!-- Onglet 1 : Lignes Budgétaires -->
            <TabItem Header="Lignes Budgétaires">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Formulaire d'ajout rapide -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tableau budgétaire -->
                        <RowDefinition Height="*"/>
                        <!-- Pied de page avec totaux -->
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <!-- Formulaire d'ajout rapide -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Margin="5,5,5,10" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Ajouter une ligne budgétaire" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- En-têtes -->
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Description" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="📝 Enrichir" Command="{Binding EnrichirLigneBudgetaireCommand}" 
                                                Background="Transparent" Foreground="#0284C7" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Enrichir avec l'IA"/>
                                        <Button Grid.Column="2" Content="🔄 Reformuler" Command="{Binding ReformulerLigneBudgetaireCommand}" 
                                                Background="Transparent" Foreground="#0284C7" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Reformuler avec l'IA"/>
                                        <Button Grid.Column="3" Content="✨ Suggérer" Command="{Binding SuggererLigneBudgetaireCommand}" 
                                                Background="Transparent" Foreground="#8B5CF6" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="✨ Suggérer par l'IA"/>
                                        <Button Grid.Column="4" Content="✨ Générer" Command="{Binding GenererLigneBudgetaireCommand}" 
                                                Background="Transparent" Foreground="#8B5CF6" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="✨ Générer par l'IA"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                    <TextBlock Text="Catégorie" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}" DisplayMemberPath="Name" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Margin="5,0,5,0">
                                    <TextBlock Text="Activité liée" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding Activities}" SelectedItem="{Binding NewActivity}" DisplayMemberPath="DisplayName" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="5,0,5,0">
                                    <TextBlock Text="Unité" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding NewUnit}" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="5,0,5,0">
                                    <TextBlock Text="Qté" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding NewQuantity}" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="5" Margin="5,0,5,0">
                                    <TextBlock Text="Coût Unitaire" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding NewUnitCost}" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6" Margin="5,0,5,0">
                                    <TextBlock Text="Fréq." FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding NewFrequency}" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="7" Margin="5,0,5,0">
                                    <TextBlock Text="Part Asso." FontSize="11" Foreground="#10B981" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NewFundingAssociation}" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="8" Margin="5,0,5,0">
                                    <TextBlock Text="Cofinance." FontSize="11" Foreground="#3B82F6" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NewFundingCofinancing}" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="9" Margin="5,0,5,0">
                                    <TextBlock Text="Demandé" FontSize="11" Foreground="#EF4444" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NewFundingRequested}" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="10" Content="Ajouter" Command="{Binding AddBudgetItemCommand}"
                                        Width="80" Height="28" VerticalAlignment="Bottom" Margin="5,0,0,0"
                                        Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tableau budgétaire -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="5,0,5,10" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <DataGrid ItemsSource="{Binding BudgetItems}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" BorderBrush="#E2E8F0" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryName}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Activité" Binding="{Binding ActivityName}" Width="150" IsReadOnly="True" Foreground="#38BDF8"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="60"/>
                                <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="50"/>
                                <DataGridTextColumn Header="Coût Unit." Binding="{Binding UnitCost, StringFormat='{}{0:N2}'}" Width="80"/>
                                <DataGridTextColumn Header="Fréq." Binding="{Binding Frequency}" Width="50"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalCost, StringFormat='{}{0:N2}'}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Part Asso." Binding="{Binding FundingAssociation, StringFormat='{}{0:N2}'}" Width="85"/>
                                <DataGridTextColumn Header="Cofinancement" Binding="{Binding FundingCofinancing, StringFormat='{}{0:N2}'}" Width="95"/>
                                <DataGridTextColumn Header="Demandé" Binding="{Binding FundingRequested, StringFormat='{}{0:N2}'}" Width="85"/>

                                <!-- Équilibre -->
                                <DataGridTemplateColumn Header="Équil." Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="12" Height="12" CornerRadius="6" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDistributionBalanced}" Value="True">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                                <Setter Property="ToolTip" Value="La ventilation budgétaire est équilibrée."/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDistributionBalanced}" Value="False">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                <Setter Property="ToolTip" Value="Erreur : la somme des ventilations ne correspond pas au total !"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Action -->
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Supprimer" Command="{Binding DataContext.DeleteBudgetItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Pied de page avec totaux -->
                    <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Margin="5,0,5,5" Padding="20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Part Association" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalAssociation, StringFormat={}{0:N2} €}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Total Cofinancements" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalCofinancing, StringFormat={}{0:N2} €}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Demandé au Bailleur" Foreground="#98E2F8" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalRequested, StringFormat={}{0:N2} €}" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Total Budget Global -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="BUDGET GLOBAL TOTAL" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2} €}" Foreground="#10B981" FontSize="20" FontWeight="Black" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Onglet 2 : Cofinancement Multi-Sources -->
            <TabItem Header="Plan de Cofinancement">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Tableau des sources (6*) -->
                        <ColumnDefinition Width="6*"/>
                        <!-- Formulaire d'ajout et ratio (4*) -->
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tableau des sources -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="5" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Sources de Financement &amp; Cofinancement" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                            
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FundingSources}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" BorderBrush="#E2E8F0" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Name}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                                    <DataGridTextColumn Header="Nature" Binding="{Binding NatureOfFunding}" Width="80"/>
                                    <DataGridTextColumn Header="Montant" Binding="{Binding TotalAmountAllocated, StringFormat='{}{0:N2}'}" Width="110"/>
                                    <DataGridTextColumn Header="Devise" Binding="{Binding Currency}" Width="60"/>
                                    <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="90"/>
                                    
                                    <!-- Action -->
                                    <DataGridTemplateColumn Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Supprimer" Command="{Binding DataContext.DeleteFundingSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Formulaire d'ajout et ratio -->
                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <!-- Formulaire de saisie -->
                            <RowDefinition Height="*"/>
                            <!-- Carte de synthèse / Ratio -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Formulaire de saisie -->
                        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="5,0,5,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Ajouter une source financière" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Nom de la source" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding NewSourceName, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Type de contribution" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                            <ComboBox ItemsSource="{Binding FundingTypes}" SelectedItem="{Binding NewSourceType}" Height="30" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Nature" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                                <ComboBox ItemsSource="{Binding FundingNatures}" SelectedItem="{Binding NewSourceNature}" Height="30" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Statut" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                                <ComboBox ItemsSource="{Binding FundingStatuses}" SelectedItem="{Binding NewSourceStatus}" Height="30" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Montant alloué" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding NewSourceAmount}" Height="30" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Devise" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding NewSourceCurrency}" Height="30" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>

                                <Button Grid.Row="2" Content="Ajouter la source financière" Command="{Binding AddFundingSourceCommand}"
                                        Height="32" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,15,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Carte de synthèse / Ratio -->
                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="20" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Ratios Financiers du Projet" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ratio Cofinancement / Subvention :" Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CofinancingRatio, StringFormat='{}{0:F2}'}" Foreground="#38BDF8" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Un ratio de cofinancement supérieur à 0.50 est généralement recommandé par les bailleurs." Foreground="#64748B" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

