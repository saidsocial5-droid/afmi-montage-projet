<UserControl x:Class="AFMI_Montage_projet_2.Views.ProjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
             xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
             xmlns:strategic="clr-namespace:AFMI_Montage_projet_2.Views.Strategic"
             xmlns:stratvm="clr-namespace:AFMI_Montage_projet_2.ViewModels.Strategic"
             xmlns:radarviews="clr-namespace:AFMI_Montage_projet_2.Views.Radar"
             xmlns:radarvm="clr-namespace:AFMI_Montage_projet_2.ViewModels.Radar"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- DataTemplates pour chaque sous-vue de l'espace de travail -->
        <DataTemplate DataType="{x:Type stratvm:StrategicPlanningViewModel}">
            <strategic:StrategicPlanningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CadrageViewModel}">
            <local:CadrageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CadreLogiqueViewModel}">
            <local:CadreLogiqueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ChronogrammeViewModel}">
            <local:ChronogrammeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BudgetViewModel}">
            <local:BudgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ExportViewModel}">
            <local:ExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <local:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AuditViewModel}">
            <local:AuditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:IndicateursViewModel}">
            <local:IndicateursView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FormulaireDynamiqueViewModel}">
            <local:FormulaireDynamiqueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RisquesViewModel}">
            <local:RisquesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ActivityReportsViewModel}">
            <local:ActivityReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <local:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SeMilestonesViewModel}">
            <local:SeMilestonesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CollaborationViewModel}">
            <local:CollaborationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ArbreProblemeViewModel}">
            <local:ArbreProblemeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AnalyseDocumentsViewModel}">
            <local:AnalyseDocumentsView />
        </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:ApprovalInboxViewModel}">
            <local:ApprovalInboxView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CloudSyncViewModel}">
            <local:CloudSyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type radarvm:ProjectRadarViewModel}">
            <radarviews:ProjectRadarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:OrganizationProfileViewModel}">
            <local:OrganizationProfileView />
        </DataTemplate>


        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Style pour les boutons du menu latéral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#38BDF8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style spécifique pour le bouton actif -->
        <Style x:Key="ActiveSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#38BDF8" BorderThickness="4,0,0,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              Margin="11,0,15,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Barre latérale -->
            <ColumnDefinition Width="220"/>
            <!-- Contenu principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="#0F172A" Padding="0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Titre / Infos de l'organisation -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu de navigation -->
                    <RowDefinition Height="*"/>
                    <!-- Bouton Retour -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Infos organisation -->
                <Grid Grid.Row="0" Margin="15,0,15,25">
                    <StackPanel>
                        <TextBlock Text="AFMI PROJET" Foreground="White" FontSize="16" FontWeight="ExtraBold"/>
                        <TextBlock Text="{Binding Project.Title}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ShowNotificationsCommand}">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="16" Foreground="#94A3B8"/>
                            <Border Background="#EF4444" CornerRadius="10" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                    Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationsCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Menu de navigation avec défilement pour les petits écrans -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Radar des Projets (Opportunités & Bailleurs) -->
                        <Button Content="📡 Radar des Projets" Command="{Binding NavigateToProjectRadarCommand}"
                                Visibility="{Binding IsProjectRadarEnabled, Converter={StaticResource BoolToVisConverter}}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="ProjectRadar" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Profil de l'Association & Capacités Institutionnelles -->
                        <Button Content="🏛️ Profil de l'Association" Command="{Binding NavigateToOrganizationProfileCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="OrganizationProfile" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- 1. Planification Stratégique & Analyse des Données -->
                        <Button Content="🧭 Planification Stratégique" Command="{Binding NavigateToStrategicPlanningCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="StrategicPlanning" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Fiche d'identité / Cadrage -->
                        <Button Content="📋 Fiche de cadrage" Command="{Binding NavigateToCadrageCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Cadrage" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Arbre de Problèmes -->
                        <Button Content="🌳 Arbre de Problèmes" Command="{Binding NavigateToArbreProblemeCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="ArbreProbleme" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Analyse de Documents -->
                        <Button Content="📄 Analyse de Documents" Command="{Binding NavigateToAnalyseDocumentsCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="AnalyseDocuments" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Formulaire Sectoriel -->
                        <Button Content="📋 Formulaire Sectoriel" Command="{Binding NavigateToFormulaireDynamiqueCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="FormulaireDynamique" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Cadre Logique -->
                        <Button Content="📊 Cadre Logique" Command="{Binding NavigateToCadreLogiqueCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="CadreLogique" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Indicateurs -->
                        <Button Content="🎯 Indicateurs de suivi" Command="{Binding NavigateToIndicateursCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Indicateurs" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Risques -->
                        <Button Content="⚠️ Gestion des risques" Command="{Binding NavigateToRisquesCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Risques" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Chronogramme -->
                        <Button Content="📅 Chronogramme (Gantt)" Command="{Binding NavigateToChronogrammeCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Chronogramme" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Budget -->
                        <Button Content="💰 Budget Prévisionnel" Command="{Binding NavigateToBudgetCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Budget" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Plan S&E -->
                        <Button Content="📅 Suivi &amp; Évaluation" Command="{Binding NavigateToSeMilestonesCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="SeMilestones" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Tableau de bord -->
                        <Button Content="📈 Tableau de Bord" Command="{Binding NavigateToDashboardCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Dashboard" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Comptes Rendus d'Exécution -->
                        <Button Content="📝 Comptes Rendus d'Activités" Command="{Binding NavigateToActivityReportsCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="ActivityReports" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Espace Collaboratif -->
                        <Button Content="🤝 Espace Collaboratif (Meet)" Command="{Binding NavigateToCollaborationCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Collaboration" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Agent Conseil IA -->
                        <Button Content="🤖 Agent Conseil IA" Command="{Binding NavigateToAuditCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Audit" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Exports -->
                        <Button Content="📤 Génération &amp; Exports" Command="{Binding NavigateToExportCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Export" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Boîte de Réception -->
                        <Button Content="&#x1F4E5; Boîte de Réception" Command="{Binding NavigateToApprovalInboxCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="ApprovalInbox" 
                                                                       ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                       InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Paramètres -->
                        <Button Content="⚙️ Paramètres" Command="{Binding NavigateToSettingsCommand}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="Settings" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>
                        <!-- Paramètres Cloud & Sync -->
                        <Button Content="☁️ Paramètres Cloud &amp; Sync" Command="{Binding NavigateToCloudSyncCommand}" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisConverter}}">
                            <Button.Style>
                                <Binding Path="ActiveTabName">
                                    <Binding.Converter>
                                        <local:TabNameToStyleConverter ActiveTabName="CloudSync" 
                                                                      ActiveStyle="{StaticResource ActiveSidebarButtonStyle}" 
                                                                      InactiveStyle="{StaticResource SidebarButtonStyle}"/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Style>
                        </Button>

                        <!-- Ouvrir l'Assistant IA -->
                        <Button Content="💬 Assistant IA Chat" Command="{Binding ToggleAiPanelCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiPanelVisible}" Value="True">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                                  <!-- Sync Status Indicator -->
                  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,15,5">
                      <TextBlock Text="&#x21BA;" Foreground="#38BDF8" FontWeight="Bold" FontSize="16" Margin="0,0,5,0">
                          <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                      <DataTrigger Binding="{Binding SyncStatus}" Value="Synchronisation en cours...">
                                          <DataTrigger.EnterActions>
                                              <BeginStoryboard x:Name="spin">
                                                  <Storyboard>
                                                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                  </Storyboard>
                                              </BeginStoryboard>
                                          </DataTrigger.EnterActions>
                                          <DataTrigger.ExitActions>
                                              <StopStoryboard BeginStoryboardName="spin"/>
                                          </DataTrigger.ExitActions>
                                      </DataTrigger>
                                  </Style.Triggers>
                              </Style>
                          </TextBlock.Style>
                          <TextBlock.RenderTransform>
                              <RotateTransform Angle="0" CenterX="8" CenterY="8"/>
                          </TextBlock.RenderTransform>
                      </TextBlock>
                      <TextBlock Text="{Binding SyncStatus, FallbackValue='Hors ligne'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                  </StackPanel>

                  <!-- Bouton Quitter -->
                <Button Grid.Row="2" Content="🚪 Fermer le projet" Command="{Binding CloseWorkspaceCommand}"
                        Background="Transparent" Foreground="#F43F5E" FontWeight="SemiBold" Height="40" Margin="15,0"
                        HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Zone de contenu principal de l'espace de travail -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Stepper du Projet (Cycle de Vie RBM - 9 Étapes) -->
            <strategic:ProjectStepperControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" DataContext="{Binding Stepper}" Margin="0,0,0,10"/>

            <!-- Sous-vue active -->
            <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding CurrentSubViewModel}" />

            <!-- Panneau latéral Assistant IA -->
            <local:AiAssistantPanelView Grid.Row="1" Grid.Column="1" Width="350" 
                                       DataContext="{Binding AiAssistantPanel}"
                                       Visibility="{Binding DataContext.IsAiPanelVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"/>
        </Grid>

        <!-- Popup Notifications -->
        <Popup IsOpen="{Binding IsNotificationsOpen}" Placement="Mouse" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Width="320" MaxHeight="400" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#94A3B8" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Notifications" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                        <Button Content="Tout marquer comme lu" Command="{Binding MarkAllNotificationsReadCommand}" Background="Transparent" BorderThickness="0" Foreground="#0EA5E9" FontSize="11" Cursor="Hand" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Indicateur non-lu -->
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#3B82F6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='g'}" FontSize="9" Foreground="#94A3B8" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Message si aucune notification -->
                    <TextBlock Grid.Row="1" Text="Aucune notification." Foreground="#94A3B8" FontSize="12" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>







