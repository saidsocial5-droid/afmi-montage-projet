<UserControl x:Class="AFMI_Montage_projet_2.Views.CadreLogiqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
             xmlns:helpers="clr-namespace:AFMI_Montage_projet_2.Helpers"
             xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <!-- Bandeau de sélection d'Objectif Spécifique (OS) -->
            <RowDefinition Height="60"/>
            <!-- Contenu dynamique -->
            <RowDefinition Height="*"/>
            <!-- Pied de page -->
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Bandeau de sélection d'OS -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Sélectionner l'Objectif Spécifique : " Foreground="#475569" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                
                <ComboBox Grid.Column="1" ItemsSource="{Binding Objectives}" SelectedItem="{Binding SelectedObjective}"
                          DisplayMemberPath="Code" Height="35" Width="150" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Contenu dynamique -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <!-- Formulaire Résultats à gauche -->
                <ColumnDefinition Width="300"/>
                <!-- Liste des résultats, activités, indicateurs à droite -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Volet gauche : Infos OS & Ajout Résultats -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Infos OS -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <Border Background="#E0F2FE" CornerRadius="4" Width="45" Height="22" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedObjective.Code}" Foreground="#0369A1" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Description de l'Objectif :" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding SelectedObjective.Description}" Foreground="White" FontSize="13" TextWrapping="Wrap" FontWeight="Medium" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- Formulaire Ajout de Résultat attendu -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Ajouter un Résultat attendu" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>
                        <TextBlock Text="Un résultat concret découlant des activités menées pour atteindre cet objectif spécifique." 
                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="16"/>

                          <Grid Margin="0,0,0,5">
                              <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="Description du résultat attendu :" Foreground="#475569" FontWeight="Medium" FontSize="12" VerticalAlignment="Center"/>
                              <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                  <Button Content="📝 Enrichir" Command="{Binding EnrichirResultatCommand}"
                                          Background="Transparent" Foreground="#0284C7" BorderThickness="0" 
                                          Padding="6,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Enrichir avec l'IA"/>
                                  <Button Content="🔄 Reformuler" Command="{Binding ReformulerResultatCommand}"
                                          Background="Transparent" Foreground="#0284C7" BorderThickness="0" 
                                          Padding="6,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Reformuler avec l'IA"/>
                                  <Button Content="✨ Suggérer" Command="{Binding SuggererResultatCommand}"
                                          Background="Transparent" Foreground="#8B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" 
                                          Padding="8,4" Margin="0,0,5,0" Cursor="Hand">
                                      <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                  </Button>
                                  <Button Content="✨ Générer" Command="{Binding GenererResultatCommand}"
                                          Background="#8B5CF6" Foreground="White" BorderThickness="0" 
                                          Padding="8,4" Cursor="Hand">
                                      <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                  </Button>
                              </StackPanel>
                          </Grid>
                          <TextBox Text="{Binding NewResultDescription, UpdateSourceTrigger=PropertyChanged}" 
                                   TextWrapping="Wrap" AcceptsReturn="True" Height="100" 
                                   VerticalScrollBarVisibility="Auto" Padding="5" Margin="0,0,0,15"/>
                          <Button Content="Créer le Résultat" Command="{Binding AddResultCommand}"
                                  Height="35" Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Volet droit : Liste des Résultats (Activities, Indicators) -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Chaîne de Résultats &amp; Activités" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                    <!-- ScrollViewer pour défiler si beaucoup d'activités -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <ItemsControl ItemsSource="{Binding SelectedObjective.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Carte de Résultat attendu -->
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20" Background="#F8FAFC">
                                        <StackPanel>
                                            <!-- En-tête Résultat -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Border Grid.Column="0" Background="#FEF3C7" CornerRadius="4" Width="55" Height="24" HorizontalAlignment="Left" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Code}" Foreground="#D97706" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" helpers:CollaborativeUI.IsCollaborativeText="True" FontWeight="Bold" FontSize="14" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    
                                                    <!-- Affichage Collaboratif -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <!-- Badge Statut -->
                                                        <Border CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                            <Setter Property="Background" Value="#FEF08A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                            <Setter Property="Background" Value="#FECACA"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="✅ Approuvé"/>
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                                <Setter Property="Text" Value="🟢 En attente"/>
                                                                                <Setter Property="Foreground" Value="#854D0E"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                                <Setter Property="Text" Value="❌ Rejeté"/>
                                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        
                                                        <!-- Auteur -->
                                                        <TextBlock FontSize="11" Foreground="#64748B" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding ProposedByUser.Username, StringFormat='Proposé par @{0}'}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAnonymized}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProposedByUser}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <!-- Actions Admin -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="✅" ToolTip="Approuver"
                                                                Command="{Binding DataContext.ApproveResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" Width="22" Height="22" Margin="0,0,5,0">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="11"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button Content="✏️" ToolTip="Approuver &amp; Anonymiser"
                                                                Command="{Binding DataContext.ApproveAndAnonymizeResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" Width="28" Height="22" Margin="0,0,5,0">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="11"/></Style></Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Content="Supprimer" 
                                                            Command="{Binding DataContext.DeleteResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>

                                            <Separator Background="#E2E8F0" Margin="0,5,0,15"/>

                                            <!-- Section Produits (Outputs) de ce Résultat -->
                                            <TextBlock Text="Produits (Outputs) attendus :" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                                            <ItemsControl ItemsSource="{Binding Outputs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#F3E8FF" CornerRadius="3" Width="55" Height="22" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Code}" Foreground="#7E22CE" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Description}" helpers:CollaborativeUI.IsCollaborativeText="True" FontSize="12" Foreground="#334155" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="2" Content="❌" 
                                                                    Command="{Binding DataContext.DeleteOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="10,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Formulaire Ajout de Produit -->
                                            <Expander Header="Ajouter un Produit (Output) pour ce résultat" FontSize="11" Foreground="#8B5CF6" Margin="0,5,0,10" ExpandDirection="Down">
                                                <Grid Margin="0,5,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                                                                          <Grid Grid.Column="0">
                                                          <Grid.ColumnDefinitions>
                                                              <ColumnDefinition Width="*"/>
                                                              <ColumnDefinition Width="Auto"/>
                                                              <ColumnDefinition Width="Auto"/>
                                                              <ColumnDefinition Width="Auto"/>
                                                              <ColumnDefinition Width="Auto"/>
                                                          </Grid.ColumnDefinitions>
                                                          <TextBox Grid.Column="0" Text="{Binding DataContext.NewOutputDescription, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="3"/>
                                                          <Button Grid.Column="1" Content="📝 Enrichir" 
                                                                  Command="{Binding DataContext.EnrichirProduitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  Background="Transparent" Foreground="#0284C7" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Enrichir avec l'IA"/>
                                                          <Button Grid.Column="2" Content="🔄 Reformuler" 
                                                                  Command="{Binding DataContext.ReformulerProduitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  Background="Transparent" Foreground="#0284C7" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Reformuler avec l'IA"/>
                                                          <Button Grid.Column="3" Content="✨ Suggérer" 
                                                                  Command="{Binding DataContext.SuggererProduitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                                  Background="Transparent" Foreground="#8B5CF6" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Suggérer par l'IA"/>
                                                          <Button Grid.Column="4" Content="✨ Générer" 
                                                                  Command="{Binding DataContext.GenererProduitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                                  Background="Transparent" Foreground="#8B5CF6" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Générer par l'IA"/>
                                                      </Grid>
                                                      <Button Grid.Column="1" Content="Ajouter Produit" Command="{Binding DataContext.AddOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Background="#8B5CF6" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="5,0,0,0" Cursor="Hand"/>
                                                </Grid>
                                            </Expander>

                                            <!-- Section Activités de ce Résultat -->
                                            <TextBlock Text="Activités rattachées :" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,10"/>

                                            <!-- ItemsControl pour lister les activités -->
                                            <ItemsControl ItemsSource="{Binding Activities}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                                                            <StackPanel>
                                                                <!-- En-tête Activité -->
                                                                <Grid Margin="0,0,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                                                        <Border Background="#DCFCE7" CornerRadius="4" Width="65" Height="22" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Code}" Foreground="#16A34A" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Output.Code}" Foreground="#7E22CE" FontWeight="Bold" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Description}" helpers:CollaborativeUI.IsCollaborativeText="True" FontWeight="SemiBold" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                                                                        
                                                                        <!-- Affichage Collaboratif -->
                                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                            <!-- Badge Statut -->
                                                                            <Border CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                                                <Setter Property="Background" Value="#FEF08A"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                                                <Setter Property="Background" Value="#FECACA"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock FontSize="10" FontWeight="Bold">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Text" Value="✅ Approuvé"/>
                                                                                            <Setter Property="Foreground" Value="#166534"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                                                    <Setter Property="Text" Value="🟢 En attente"/>
                                                                                                    <Setter Property="Foreground" Value="#854D0E"/>
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                                                    <Setter Property="Text" Value="❌ Rejeté"/>
                                                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Border>
                                                                            
                                                                            <!-- Auteur -->
                                                                            <TextBlock FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="5,0,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="{Binding ProposedByUser.Username, StringFormat='Proposé par @{0}'}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsAnonymized}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding ProposedByUser}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            
                                                                            <!-- Budget Prévisionnel -->
                                                                            <TextBlock Text="{Binding TotalBudget, StringFormat='💰 Budget Prévu : {0:N0} €'}" Foreground="#0284C7" FontWeight="Bold" FontSize="11" Margin="15,0,0,0" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                        <!-- Actions Admin -->
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <Button Content="✅" ToolTip="Approuver"
                                                                                    Command="{Binding DataContext.ApproveActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                                    Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" Width="22" Height="22" Margin="0,0,5,0">
                                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="11"/></Style></Button.Resources>
                                                                            </Button>
                                                                            <Button Content="✏️" ToolTip="Approuver &amp; Anonymiser"
                                                                                    Command="{Binding DataContext.ApproveAndAnonymizeActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                                    Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" Width="28" Height="22" Margin="0,0,5,0">
                                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="11"/></Style></Button.Resources>
                                                                            </Button>
                                                                        </StackPanel>
                                                                        <Button Content="Supprimer" 
                                                                                Command="{Binding DataContext.DeleteActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                CommandParameter="{Binding}"
                                                                                Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Section Indicateurs de l'activité -->
                                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="10" Margin="0,5,0,10">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Indicateurs SMART :" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                                                                        
                                                                        <!-- ItemsControl Indicateurs -->
                                                                        <ItemsControl ItemsSource="{Binding Indicators}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,0,0,6">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="100"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="100"/>
                                                                                            <ColumnDefinition Width="100"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        
                                                                                        <TextBlock Grid.Column="0" Text="{Binding Code}" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" helpers:CollaborativeUI.IsCollaborativeText="True" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding Baseline, StringFormat='Réf: {0}'}" FontSize="11" Foreground="#64748B"/>
                                                                                        <TextBlock Grid.Column="3" Text="{Binding Target, StringFormat='Cible: {0}'}" FontSize="11" Foreground="#16A34A" FontWeight="SemiBold"/>
                                                                                        
                                                                                        <Button Grid.Column="4" Content="❌" 
                                                                                                Command="{Binding DataContext.DeleteIndicatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                                CommandParameter="{Binding}"
                                                                                                Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="10,0,0,0"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- Formulaire Ajout Indicateur (Inline sous forme d'expander) -->
                                                                        <Expander Header="Ajouter un indicateur SMART pour cette activité" FontSize="11" Foreground="#0284C7" Margin="0,5,0,0" ExpandDirection="Down">
                                                                            <Grid Margin="0,10,0,5">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="1*"/>
                                                                                    <ColumnDefinition Width="1*"/>
                                                                                    <ColumnDefinition Width="1*"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- Description de l'indicateur -->
                                                                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                                                                    <Grid Margin="0,0,0,3">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="Indicateur (ex: Nombre de personnes formées)" Foreground="#475569" VerticalAlignment="Center"/>
                                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                                            <Button Content="📝 Enrichir" 
                                                                                                    Command="{Binding DataContext.EnrichirIndicateurCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                                    Background="Transparent" Foreground="#0284C7" BorderThickness="0" Margin="0,0,5,0" Padding="4,0" Cursor="Hand" FontWeight="SemiBold" FontSize="10" ToolTip="Enrichir avec l'IA"/>
                                                                                            <Button Content="🔄 Reformuler" 
                                                                                                    Command="{Binding DataContext.ReformulerIndicateurCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                                    Background="Transparent" Foreground="#0284C7" BorderThickness="0" Margin="0,0,5,0" Padding="4,0" Cursor="Hand" FontWeight="SemiBold" FontSize="10" ToolTip="Reformuler avec l'IA"/>
                                                                                            <Button Content="✨ Suggérer par l'IA" 
                                                                                                    Command="{Binding DataContext.SuggereIndicateursCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                                    CommandParameter="{Binding}"
                                                                                                    Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                    <TextBox Text="{Binding DataContext.NewIndicatorDescription, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="3"/>
                                                                                </StackPanel>

                                                                                <!-- Baseline -->
                                                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,5,8">
                                                                                    <TextBlock Text="Situation de Réf. (Baseline)" Foreground="#475569" Margin="0,0,0,3"/>
                                                                                    <TextBox Text="{Binding DataContext.NewIndicatorBaseline, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="3"/>
                                                                                </StackPanel>

                                                                                <!-- Target -->
                                                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,5,8">
                                                                                    <TextBlock Text="Valeur Cible (Target)" Foreground="#475569" Margin="0,0,0,3"/>
                                                                                    <TextBox Text="{Binding DataContext.NewIndicatorTarget, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="3"/>
                                                                                </StackPanel>

                                                                                <!-- Source de vérification -->
                                                                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="5,0,0,8">
                                                                                    <TextBlock Text="Source de vérification" Foreground="#475569" Margin="0,0,0,3"/>
                                                                                    <TextBox Text="{Binding DataContext.NewIndicatorSource, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="3"/>
                                                                                </StackPanel>

                                                                                <!-- Bouton Enregistrer Indicateur -->
                                                                                <Button Grid.Row="2" Grid.ColumnSpan="3" Content="Enregistrer l'Indicateur" 
                                                                                        Command="{Binding DataContext.AddIndicatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                        CommandParameter="{Binding}"
                                                                                        Height="30" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,5,0,0">
                                                                                    <Button.Resources>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="CornerRadius" Value="3"/>
                                                                                        </Style>
                                                                                    </Button.Resources>
                                                                                </Button>
                                                                            </Grid>
                                                                        </Expander>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Formulaire Ajout d'Activité pour ce Résultat -->
                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,5,0,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Sélection du Produit associé (Optionnel) -->
                                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" Orientation="Horizontal">
                                                        <TextBlock Text="Associer au Produit (Optionnel) : " FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableOutputsForSelect, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding DataContext.SelectedOutputForNewActivity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  DisplayMemberPath="Code" Width="120" Height="24" VerticalContentAlignment="Center"/>
                                                    </StackPanel>

                                                                                                        <Grid Grid.Row="1" Grid.Column="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding DataContext.NewActivityDescription, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Height="30" VerticalContentAlignment="Center" Padding="5" Tag="Saisir une nouvelle activité..."/>
                                                        <Button Grid.Column="1" Content="📝 Enrichir" 
                                                                Command="{Binding DataContext.EnrichirActiviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                Background="Transparent" Foreground="#0284C7" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Enrichir avec l'IA"/>
                                                        <Button Grid.Column="2" Content="🔄 Reformuler" 
                                                                Command="{Binding DataContext.ReformulerActiviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                Background="Transparent" Foreground="#0284C7" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Reformuler avec l'IA"/>
                                                        <Button Grid.Column="3" Content="✨ Suggérer" 
                                                                Command="{Binding DataContext.SuggererActiviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                                Background="Transparent" Foreground="#8B5CF6" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Suggérer par l'IA"/>
                                                        <Button Grid.Column="4" Content="✨ Générer" 
                                                                Command="{Binding DataContext.GenererActiviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                                Background="Transparent" Foreground="#8B5CF6" BorderThickness="0" Margin="5,0,0,0" Padding="5,0" Cursor="Hand" ToolTip="Générer par l'IA"/>
                                                    </Grid>
                                                    <Button Grid.Row="1" Grid.Column="1" Content="Ajouter Activité" 
                                                            Command="{Binding DataContext.AddActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}"
                                                            Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="5,0,0,0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Pied de page -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E293B" FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>



