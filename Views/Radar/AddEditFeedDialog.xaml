<Window x:Class="AFMI_Montage_projet_2.Views.Radar.AddEditFeedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une source de flux RSS/Atom"
        Icon="/app_icon.ico"
        Height="540" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📡 Ajouter une nouvelle source de financement" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Indiquez l'URL du flux RSS ou Atom institutionnel pour l'inclure dans la veille automatique." 
                           Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Feed Name -->
                <TextBlock Text="Nom du flux ou de l'appel :" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12"/>

                <!-- Feed URL -->
                <TextBlock Text="URL du flux RSS/Atom (HTTPS recommandé) :" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlTextBox" Grid.Column="0" Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="🔍 Tester la connexion" Click="TestConnection_Click"
                            Background="#0284C7" Foreground="White" FontWeight="SemiBold"
                            Padding="12,0" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Test Result Banner -->
                <Border x:Name="TestResultBorder" Visibility="Collapsed" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                    <TextBlock x:Name="TestResultText" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <!-- Catégorie / Bailleur -->
                <TextBlock Text="Catégorie institutionnelle (ex: Coopération Internationale, Environnement...) :" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="CategoryTextBox" Text="Environnement &amp; Climat" Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12"/>

                <!-- Topic / Sujet -->
                <TextBlock Text="Thématique ou Bailleurs ciblés (ex: GEF, UE, Appels territoriaux...) :" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TopicTextBox" Text="Subventions &amp; Appels à projets" Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12"/>

                <!-- Langue du flux -->
                <TextBlock Text="Langue principale du flux :" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="LanguageComboBox" SelectedIndex="0" Height="32" FontSize="13" Margin="0,0,0,12">
                    <ComboBoxItem Content="Français (fr)"/>
                    <ComboBoxItem Content="Arabe (ar)"/>
                    <ComboBoxItem Content="Anglais (en)"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="Cancel_Click"
                    Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold"
                    Padding="15,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
            <Button Content="💾 Enregistrer la Source" Click="Save_Click"
                    Background="#059669" Foreground="White" FontWeight="Bold"
                    Padding="20,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
