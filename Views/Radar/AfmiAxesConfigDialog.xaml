<Window x:Class="AFMI_Montage_projet_2.Views.Radar.AfmiAxesConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration des 5 Axes Stratégiques AFMI"
        Icon="/app_icon.ico"
        Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#064E3B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="🌲 Les 5 Grands Axes Stratégiques de l'AFMI" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Les 5 axes majeurs d'intervention du plan d'action et du plan stratégique AFMI pour le ciblage et l'évaluation IA des opportunités de subventions." 
                           Foreground="#A7F3D0" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Gouvernance concertée • Ressources naturelles • Énergie &amp; habitat • Diversification des revenus • Communication &amp; mise en réseau."
                           Foreground="#FDE68A" FontSize="11" Margin="0,4,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Axes List -->
        <DataGrid Grid.Row="1" x:Name="AxesDataGrid" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                  RowHeaderWidth="0" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="40" IsReadOnly="True" FontWeight="Bold"/>
                <DataGridTextColumn Header="Titre de l'Axe" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="Description &amp; Mots-clés" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
                <DataGridCheckBoxColumn Header="Validé" Binding="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="Cancel_Click"
                    Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold"
                    Padding="15,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
            <Button Content="💾 Enregistrer les 5 Axes" Click="Save_Click"
                    Background="#059669" Foreground="White" FontWeight="Bold"
                    Padding="20,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
