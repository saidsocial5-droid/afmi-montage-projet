<UserControl x:Class="AFMI_Montage_projet_2.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
             xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
             xmlns:converters="clr-namespace:AFMI_Montage_projet_2.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="60"/>
            <!-- Navigation par onglets -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Audit &amp; Agent IA" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Analysez votre dossier, corrigez vos textes et interagissez avec les documents externes." Foreground="#94A3B8" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Contenu -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="15,10,15,5">
            <TabControl.Resources>
                <!-- Style simple pour les onglets -->
                <Style TargetType="TabItem">
                    <Setter Property="Header" Value="{Binding Header}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#0EA5E9" 
                                        BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,5,0">
                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#0EA5E9"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,3"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Onglet 1 : Audit & Diagnostic -->
            <TabItem Header="🔍 Audit de Cohérence &amp; Logique">
                <Grid Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Actions -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Analyse globale de la cohérence du projet" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="Le diagnostic croise automatiquement le socle stratégique, l'arbre à problèmes, le cadre logique, les indicateurs, le chronogramme, le budget, le financement et les risques (hors-ligne, sans IA). L'audit IA s'appuie ensuite sur ces constats pour analyser le fond et proposer un plan d'action."
                                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,3,10,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🔄 Actualiser le diagnostic" Command="{Binding LancerDiagnosticCommand}"
                                    Height="36" Padding="14,0" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#1E293B" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="2" Content="🤖 Audit IA approfondi" Command="{Binding LancerAuditCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="36" Padding="14,0" Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Synthèse : score + étapes -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Score de qualité" FontSize="12" Foreground="#64748B"/>
                                <TextBlock FontSize="34" FontWeight="Bold" Foreground="#0F172A">
                                    <Run Text="{Binding Analysis.Quality.QualityScore, Mode=OneWay, FallbackValue=–}"/><Run Text=" / 100" FontSize="16" Foreground="#64748B"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Analysis.ScoreLabel, FallbackValue=Analyse en cours...}" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,8"/>
                                <TextBlock FontSize="12" Foreground="#334155">
                                    <Run Text="⛔"/> <Run Text="{Binding Analysis.Quality.CriticalCount, Mode=OneWay, FallbackValue=0}"/><Run Text=" critique(s)"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#334155">
                                    <Run Text="⚠️"/> <Run Text="{Binding Analysis.Quality.WarningCount, Mode=OneWay, FallbackValue=0}"/><Run Text=" avertissement(s)"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#334155">
                                    <Run Text="ℹ️"/> <Run Text="{Binding Analysis.Quality.InfoCount, Mode=OneWay, FallbackValue=0}"/><Run Text=" information(s)"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#334155" Margin="0,8,0,0">
                                    <Run Text="Montage :"/> <Run Text="{Binding Analysis.ReadinessPercent, Mode=OneWay, FallbackValue=0}"/><Run Text=" % des étapes terminées"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3" Padding="8,5" CornerRadius="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                ToolTip="{Binding GapsText}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="{Binding StatusColor}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>

                    <!-- Constats + rapport IA -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                            </Border.Effect>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Constats du diagnostic" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <TextBlock DockPanel.Dock="Top" Text="✅ Aucun constat : le dossier respecte toutes les règles contrôlées." Foreground="#10B981"
                                           Visibility="{Binding Findings.Count, Converter={StaticResource InverseCountToVisibilityConverter}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="FindingCard" Margin="0,0,0,8" Padding="10,8" CornerRadius="4" BorderThickness="4,0,0,0"
                                                        BorderBrush="#94A3B8" Background="#F8FAFC">
                                                    <StackPanel>
                                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#0F172A">
                                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                                            <Run Text="{Binding RuleId, Mode=OneWay, StringFormat=' [{0}]'}" Foreground="#94A3B8" FontWeight="Normal" FontSize="10"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#64748B" Margin="0,1,0,3"/>
                                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12" Foreground="#334155"/>
                                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#0369A1" Margin="0,3,0,0">
                                                            <Run Text="➜ "/><Run Text="{Binding Recommendation, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter TargetName="FindingCard" Property="BorderBrush" Value="#DC2626"/>
                                                        <Setter TargetName="FindingCard" Property="Background" Value="#FEF2F2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter TargetName="FindingCard" Property="BorderBrush" Value="#F59E0B"/>
                                                        <Setter TargetName="FindingCard" Property="Background" Value="#FFFBEB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                        <Setter TargetName="FindingCard" Property="BorderBrush" Value="#0EA5E9"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Rapport d'audit IA -->
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                            </Border.Effect>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Rapport d'audit IA" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding AuditReport}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="13" Foreground="#334155"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Onglet 2 : Brainstorming & Idéation -->
            <TabItem Header="💡 Générateur d'Idées &amp; Brainstorming">
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Saisie et Options -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,15,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Améliorer / Innover un projet" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            <TextBlock Text="Sélectionnez un projet en cours, indiquez un thème d'amélioration, et laissez l'IA l'enrichir." 
                                       Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="16"/>

                            <TextBlock Text="Sélectionner le projet à améliorer :" Foreground="#475569" FontWeight="Medium" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedBrainstormProject}" DisplayMemberPath="Title" Height="35" Padding="5" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <TextBlock Text="Thème ou secteur d'intervention (optionnel) :" Foreground="#475569" FontWeight="Medium" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding BrainstormTheme, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15" Tag="Ex: école mobile, énergie solaire..."/>

                            <TextBlock Text="Langue de génération :" Foreground="#475569" FontWeight="Medium" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" Height="35" Padding="5" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <CheckBox IsChecked="{Binding GenerateDetailed}" Content="Générer une réponse longue et détaillée" 
                                      Foreground="#475569" FontWeight="Medium" FontSize="11" Margin="0,0,0,5" Cursor="Hand"/>

                            <CheckBox IsChecked="{Binding SearchInternet}" Content="Rechercher des exemples réels sur Internet" 
                                      Foreground="#475569" FontWeight="Medium" FontSize="11" Margin="0,0,0,15" Cursor="Hand"/>

                            <Button Content="Générer des Idées" Command="{Binding GenererIdeesCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="35" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                            
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#0EA5E9" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Résultats et Intégration -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Titre -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IntegrateTitle}" Content="Appliquer ce nouveau Titre" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding GeneratedTitle, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Contexte -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IntegrateContext}" Content="Appliquer ce nouveau Contexte &amp; Justification" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding GeneratedContext, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontSize="12" MinHeight="60"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Objectif -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IntegrateObjective}" Content="Appliquer ce nouvel Objectif Général" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding GeneratedObjective, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontSize="12" MinHeight="40"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cadre Logique -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IntegrateLogicalFramework}" Content="Appliquer ce nouveau Cadre Logique (Créera les OS, Résultats et Activités dans le projet)" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding GeneratedLogicalFramework, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontSize="12" MinHeight="100"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <TextBlock Text="Rapport détaillé de l'IA (Sources Internet, idées complémentaires) :" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="0,10,0,5"/>
                                    <TextBox Text="{Binding BrainstormResult}" IsReadOnly="True" BorderThickness="0" Background="#F1F5F9" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" MinHeight="100" Padding="10" Foreground="#334155"/>
                                </StackPanel>
                            </ScrollViewer>
                            
                            <Grid Grid.Row="1" Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" Content="✨ Enrichir le texte" Command="{Binding EnrichirIdeesCommand}"
                                        Height="40" Background="#8B5CF6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Développer et détailler davantage la proposition de l'IA">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                                
                                <Button Grid.Column="2" Content="Valider et Intégrer les éléments cochés au projet" Command="{Binding IntegrerIdeesCommand}"
                                        Height="40" Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Onglet 3 : Correction de textes -->
            <TabItem Header="✍️ Correction &amp; Style">
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Texte original -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Texte à corriger / améliorer :" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            
                            <TextBox Grid.Row="1" Text="{Binding TextToCorrect, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" BorderBrush="#CBD5E1" 
                                     Padding="10" FontSize="13" Foreground="#334155"/>

                            <Button Grid.Row="2" Content="Améliorer le texte" Command="{Binding CorrigerTexteCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="36" Background="#8B5CF6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,15,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Texte corrigé -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Texte corrigé (Style professionnel) :" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            
                            <TextBox Grid.Row="1" Text="{Binding CorrectedText}" IsReadOnly="True" AcceptsReturn="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" 
                                     FontSize="13" Foreground="#10B981"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Onglet 4 : Analyse de documents -->
            <TabItem Header="📄 Analyse de Documents (IA)">
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chargement du document -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Importer un document de référence" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            <TextBlock Text="Ex: Appel à projets du bailleur, canevas à respecter, plan de développement local..." 
                                       Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <Button Content="📂 Choisir un fichier (PDF, Word...)" Command="{Binding LoadDocumentCommand}"
                                    Height="35" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <TextBlock Text="{Binding UploadedFileName}" Foreground="#0EA5E9" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,20"/>

                            <TextBlock Text="Que voulez-vous savoir sur ce document ?" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding DocumentPrompt, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" 
                                     TextWrapping="Wrap" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="10" FontSize="13" Margin="0,0,0,15"
                                     Tag="Ex: Résume les critères d'éligibilité de cet appel à projets..."/>

                            <Button Content="Analyser avec l'IA" Command="{Binding AnalyzeDocumentCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                    Height="36" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Résultat de l'analyse -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Réponse de l'Agent IA :" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            
                            <TextBox Grid.Row="1" Text="{Binding DocumentReport}" IsReadOnly="True" AcceptsReturn="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" 
                                     FontSize="13" Foreground="#334155"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
        
        <!-- Barre de statut globale de la vue -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" 
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,15"/>
    </Grid>
</UserControl>

