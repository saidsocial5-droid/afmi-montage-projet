<Window x:Class="AFMI_Montage_projet_2.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
        xmlns:helpers="clr-namespace:AFMI_Montage_projet_2.Helpers"
        Title="AFMI - Créer un compte" 
        Icon="/app_icon.ico"
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized"
        Background="#F8FAFC">
    
    <Window.DataContext>
        <viewmodels:RegisterViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- Background Image -->
        <Image Source="pack://application:,,,/Assets/login_bg.jpg" Stretch="UniformToFill" />
        <Border Background="#33000000" />

        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="White" CornerRadius="12" Padding="40" Width="400" Margin="0,0,250,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.2" ShadowDepth="5" />
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="Créer un compte" FontSize="26" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,30" />
                
                <TextBlock Text="Nom d'utilisateur" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         helpers:AiTextAssistant.IsExcluded="True"
                         helpers:AiTextAssistant.ExclusionReason="Identifiant compte utilisateur"
                         Padding="10" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         helpers:AiTextAssistant.IsExcluded="True"
                         helpers:AiTextAssistant.ExclusionReason="Adresse email utilisateur"
                         Padding="10" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Mot de passe" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" />
                <PasswordBox x:Name="TxtPassword" Padding="10" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,20">
                    <PasswordBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- Message (erreur ou consigne) : visible dès qu'il n'est pas vide (il était toujours masqué avant la 1.9.25) -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Code d'accès de l'équipe : affiché quand ce poste n'a pas encore l'identifiant Google (ADR 31) -->
                <StackPanel Visibility="{Binding ShowAccessCodePanel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="Code d'accès de l'équipe" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" />
                    <TextBox Text="{Binding AccessCodeInput, UpdateSourceTrigger=PropertyChanged}"
                             helpers:AiTextAssistant.IsExcluded="True"
                             helpers:AiTextAssistant.ExclusionReason="Code d'accès d'équipe contenant le secret OAuth Google"
                             Padding="8" FontSize="12" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,6"/>
                    <Button Content="Valider le code" Command="{Binding ApplyAccessCodeCommand}" HorizontalAlignment="Right" Padding="12,5" Cursor="Hand"/>
                </StackPanel>

                <Button Content="S'inscrire avec Google" Command="{Binding RegisterWithGoogleCommand}" 
                        Background="#DBEAFE" Foreground="#1E40AF" FontWeight="Bold" FontSize="14" Padding="10" BorderThickness="1" BorderBrush="#93C5FD" Cursor="Hand" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>

                <Button Content="S'inscrire" IsDefault="True" Command="{Binding RegisterCommand}" CommandParameter="{Binding ElementName=TxtPassword}" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="16" Padding="12" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
                
                <Button Content="Annuler" Command="{Binding CancelCommand}" 
                        Background="Transparent" Foreground="#64748B" FontWeight="Bold" FontSize="14" Padding="10" BorderThickness="0" Cursor="Hand">
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
