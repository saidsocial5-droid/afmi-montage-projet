<UserControl x:Class="AFMI_Montage_projet_2.Views.ChronogrammeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
             xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <!-- Actions en haut -->
            <RowDefinition Height="60"/>
            <!-- Onglets de planification -->
            <RowDefinition Height="*"/>
            <!-- Pied de page -->
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Actions en haut -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Chronogramme &amp; Calendrier de Planification" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Planifiez et visualisez la chronologie du projet sous forme de diagramme de Gantt ou de calendrier." Foreground="#64748B" FontSize="11"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Enregistrer le Chronogramme" Command="{Binding SaveTimelineCommand}"
                        Background="#10B981" Foreground="White" FontWeight="Bold" Width="200" Height="35"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Onglets principaux -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">
            
            <!-- Onglet 1 : Diagramme de Gantt (Trimestres) -->
            <TabItem Header="Diagramme de Gantt (Trimestres)">
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,5,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                    </Border.Effect>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- En-tête du tableau Gantt -->
                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Code" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Activité" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Date Début" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Date Fin" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                
                                <ItemsControl Grid.Column="4" ItemsSource="{Binding TimelineHeaders}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" FontSize="11"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Lignes d'activités Gantt -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,12" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Code -->
                                                <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="4" Width="55" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Code}" Foreground="#16A34A" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Description -->
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Date Début -->
                                                <DatePicker Grid.Column="2" SelectedDate="{Binding StartDate}" Height="28" Width="110" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>

                                                <!-- Date Fin -->
                                                <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" Height="28" Width="110" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>

                                                <!-- Visualisation Gantt -->
                                                <ItemsControl Grid.Column="4" ItemsSource="{Binding QuarterSelections}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="18" Margin="2,0" CornerRadius="2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="True">
                                                                                <Setter Property="Background" Value="#3B82F6"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="False">
                                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Onglet 2 : Planification par Période (Calendrier) -->
            <TabItem Header="Planification par Période">
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,5,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                    </Border.Effect>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Calendrier de suivi chronologique des Activités &amp; Rapports S&amp;E" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding CalendarEvents}" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#E2E8F0" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Échéance" Binding="{Binding DateString}" Width="100"/>
                                <DataGridTemplateColumn Header="Type" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ColorBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Type}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Description de l'Événement" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="150"/>
                                <DataGridTextColumn Header="Statut / Période" Binding="{Binding Status}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Pied de page -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E293B" FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

