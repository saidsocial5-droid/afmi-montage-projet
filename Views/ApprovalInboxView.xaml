<UserControl x:Class="AFMI_Montage_projet_2.Views.ApprovalInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
             xmlns:converters="clr-namespace:AFMI_Montage_projet_2.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="950"
             Background="#F8FAFC">

    <UserControl.DataContext>
        <viewmodels:ApprovalInboxViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <converters:DiffTypeToForegroundConverter x:Key="DiffFgConverter" />
        <converters:DiffTypeToBackgroundConverter x:Key="DiffBgConverter" />
        <converters:DiffTypeToTextDecorationConverter x:Key="DiffDecorConverter" />
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Color="#E2E8F0"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="📬 Propositions de l'équipe" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Comparez chaque proposition avec la version officielle, puis approuvez-la ou rejetez-la (décision de l'administrateur)." Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RoleHint}" Foreground="#0369A1" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#x21bb; Actualiser" Command="{Binding LoadProposalsCommand}"
                        Padding="18,8" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Liste des propositions -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Proposals}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Margin" Value="0,0,0,15"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#3B82F6" BorderThickness="4,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Color="#E2E8F0"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Élément visé -->
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                                <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" Foreground="#1D4ED8" FontSize="12"/>
                                </Border>
                                <Border Background="#FEF3C7" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding StatusLabel}" FontWeight="Bold" Foreground="#B45309" FontSize="11"/>
                                </Border>
                            </StackPanel>

                            <!-- Note précédente (conflit, motif…) -->
                            <Border Background="#FFFBEB" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#FCD34D" BorderThickness="1"
                                    Visibility="{Binding HasReviewNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Contribution.ReviewNotes}" Foreground="#92400E" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Différences (modification ou suggestion) -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Visibility="{Binding IsCreation, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Texte proposé (ajouts en vert, suppressions barrées) :" FontWeight="Bold" Foreground="#475569" FontSize="12" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding DiffPieces}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding Type, Converter={StaticResource DiffFgConverter}}"
                                                           Background="{Binding Type, Converter={StaticResource DiffBgConverter}}"
                                                           TextDecorations="{Binding Type, Converter={StaticResource DiffDecorConverter}}"
                                                           FontSize="14" Margin="1,1" Padding="2,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Contenu d'un ajout -->
                            <Border Background="#F0FDF4" CornerRadius="6" Padding="14" Margin="0,0,0,12" BorderBrush="#BBF7D0" BorderThickness="1"
                                    Visibility="{Binding IsCreation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Élément proposé :" FontWeight="Bold" Foreground="#166534" FontSize="12" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding CreationDetails}" Foreground="#14532D" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding AuthorText, StringFormat='✍️ Proposé par {0}'}" Foreground="#64748B" FontSize="12" Margin="0,0,0,12"/>

                            <!-- Décision (administrateurs) -->
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="12"
                                    Visibility="{Binding DataContext.CanDecide, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{Binding CommentInput, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Commentaire pour l'auteur (motif du rejet, précision…)" Padding="8,6" Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                    <Button Grid.Column="1" Content="✔ Approuver"
                                            Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#10B981" Foreground="White" FontWeight="Bold" Padding="14,8" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="✖ Rejeter"
                                            Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Aucune proposition -->
        <TextBlock Grid.Row="1" Text="Aucune proposition en attente." Foreground="#94A3B8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Proposals.Count, Converter={StaticResource InverseCountToVisibilityConverter}, FallbackValue=Collapsed}"/>

        <!-- Barre d'état -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
