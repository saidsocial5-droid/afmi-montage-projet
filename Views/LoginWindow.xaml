<Window x:Class="AFMI_Montage_projet_2.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
        xmlns:helpers="clr-namespace:AFMI_Montage_projet_2.Helpers"
        Title="AFMI - Connexion" 
        Icon="/app_icon.ico"
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized"
        Background="#F8FAFC">
    
    <Window.DataContext>
        <viewmodels:LoginViewModel />
    </Window.DataContext>

    <Grid>
        <!-- Background Image -->
        <Image Source="pack://application:,,,/Assets/login_bg.jpg" Stretch="UniformToFill" />
        
        <!-- Overlay pour assombrir légèrement l'image -->
        <Border Background="#33000000" />

        <!-- Login Card -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="White" 
                CornerRadius="12" Padding="40" Width="400" Margin="0,0,250,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.2" ShadowDepth="5" />
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="Bienvenue sur AFMI V3" FontSize="26" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,30" />
                
                <TextBlock Text="Email ou Nom d'utilisateur" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" />
                <TextBox Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}" 
                         helpers:AiTextAssistant.IsExcluded="True" 
                         helpers:AiTextAssistant.ExclusionReason="Identifiant de connexion utilisateur"
                         Padding="10" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,20">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Mot de passe" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" />
                <PasswordBox x:Name="TxtPassword" Padding="10" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,15">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- Checkbox Se souvenir de moi -->
                <CheckBox Content="Se souvenir de moi" IsChecked="{Binding RememberMe}" Foreground="#475569" FontWeight="Medium" Margin="0,0,0,20" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="Se connecter" IsDefault="True" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=TxtPassword}" 
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="16" Padding="12" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <TextBlock Text="Pas encore de compte ?" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <Button Content="S'inscrire" Command="{Binding NavigateRegisterCommand}" Background="Transparent" Foreground="#2563EB" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0" Padding="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bouton pour personnaliser l'arrière-plan -->
        <Button Content="🖼️ Personnaliser l'arrière-plan" Command="{Binding ChangeBackgroundCommand}" 
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" 
                Background="#88000000" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
