<Window x:Class="AFMI_Montage_projet_2.Views.AiRiskGenerationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant IA — Identification &amp; Génération des Risques du Projet" 
        Height="620" Width="980"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner" 
        Background="#F8FAFC"
        FontFamily="Segoe UI, Roboto, Arial, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Barre d'outils / Sélection -->
            <RowDefinition Height="Auto"/>
            <!-- Liste des risques -->
            <RowDefinition Height="*"/>
            <!-- Pied de page -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. En-tête -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Identification Intelligente des Risques de Projet" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="L'IA a analysé le contexte, les objectifs et les activités de votre projet pour identifier les risques potentiels et formuler leurs mesures d'atténuation." 
                               Foreground="#94A3B8" FontSize="12" Margin="30,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCountSummary" Text="0 risque(s) identifié(s)" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Barre d'outils / Sélection -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cochez les risques que vous souhaitez importer dans votre Registre :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="☑️ Tout sélectionner" Click="BtnSelectAll_Click" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    <Button Content="⬜ Tout désélectionner" Click="BtnDeselectAll_Click" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Liste des risques -->
        <DataGrid Grid.Row="2" x:Name="DgRisks" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="#F8FAFC" BorderThickness="0" Margin="15" RowHeight="65"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                  HeadersVisibility="Column" SelectionMode="Single"
                  ScrollViewer.CanContentScroll="True" VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- Checkbox Sélection -->
                <DataGridTemplateColumn Width="45">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Catégorie -->
                <DataGridTemplateColumn Header="Catégorie" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#EEF2FF" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="11" Foreground="#4F46E5"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Description -->
                <DataGridTemplateColumn Header="Risque / Description" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center" Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Criticité (Score) -->
                <DataGridTemplateColumn Header="P × I = Score" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="{Binding ScoreColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RiskScore, StringFormat='Score : {0}'}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock Text="{Binding ScoreLabel}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Mesure d'Atténuation -->
                <DataGridTemplateColumn Header="Mesure d'Atténuation / Contingence" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MitigationMeasure}" TextWrapping="Wrap" FontSize="12" Foreground="#334155" VerticalAlignment="Center" Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Rôle Responsable -->
                <DataGridTemplateColumn Header="Responsable" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ResponsibleRole}" FontSize="11" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center" Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. Pied de page -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="💡 Les risques importés mettront instantanément à jour la Matrice de Criticité 5x5." 
                           Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Annuler" Click="BtnCancel_Click" 
                            Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Padding="16,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnImport" Content="📥 Importer les risques sélectionnés" Click="BtnImport_Click" 
                            Background="#0284C7" Foreground="White" BorderThickness="0" Padding="20,8" Cursor="Hand" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
