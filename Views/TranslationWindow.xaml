<Window x:Class="AFMI_Montage_projet_2.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AFMI_Montage_projet_2.Helpers"
        Title="Traduction IA — Français · العربية · English" Height="560" Width="980" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="LangButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#0369A1"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Traduire vers :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                <Button x:Name="BtnFrench" Content="🇫🇷 Français" Click="BtnFrench_Click" Style="{StaticResource LangButton}"/>
                <Button x:Name="BtnArabic" Content="العربية" Click="BtnArabic_Click" Style="{StaticResource LangButton}"/>
                <Button x:Name="BtnEnglish" Content="🇬🇧 English" Click="BtnEnglish_Click" Style="{StaticResource LangButton}"/>
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Width="90" Height="6" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock x:Name="TxtSourceInfo" Foreground="#64748B" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Texte d'origine" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtOriginal" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"
                         Background="#F1F5F9" BorderBrush="#CBD5E1" FontSize="13"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="TxtResultTitle" Text="Traduction (modifiable)" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTranslation" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8"
                         Background="White" BorderBrush="#0284C7" FontSize="13"
                         helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Résultat de traduction en cours de relecture"/>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="TxtWarnings" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Vérifiez la traduction avant de l'utiliser : chiffres, noms propres et termes techniques." Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnReplace" Content="↺ Remplacer le texte" Click="BtnReplace_Click" Style="{StaticResource ActionButton}" Background="#0284C7" Foreground="White" IsEnabled="False"/>
                <Button x:Name="BtnAppend" Content="➕ Ajouter à la suite" Click="BtnAppend_Click" Style="{StaticResource ActionButton}" Background="#E2E8F0" Foreground="#1E293B" IsEnabled="False"/>
                <Button x:Name="BtnCopy" Content="📋 Copier" Click="BtnCopy_Click" Style="{StaticResource ActionButton}" Background="#E2E8F0" Foreground="#1E293B" IsEnabled="False"/>
                <Button Content="Fermer" IsCancel="True" Click="BtnClose_Click" Style="{StaticResource ActionButton}" Background="#F1F5F9" Foreground="#475569"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
