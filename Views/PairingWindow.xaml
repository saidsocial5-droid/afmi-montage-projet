<Window x:Class="AFMI_Montage_projet_2.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
        mc:Ignorable="d"
        Title="Coupler un appareil" Height="450" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Background="#F8FAFC">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Associer l'application mobile" FontSize="20" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Ouvrez l'application Android et scannez ce code QR pour associer votre compte en toute sécurité." TextWrapping="Wrap" TextAlignment="Center" Foreground="#475569" Margin="0,0,0,20"/>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                <Grid>
                    <Image Source="{Binding QrCodeImage}" Width="200" Height="200" Stretch="Uniform"/>
                    <Border Background="#B2FFFFFF" Visibility="{Binding IsExpired, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="4">
                        <TextBlock Text="Expiré" FontWeight="Bold" FontSize="24" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,15,0,5"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Expire dans : " Foreground="#64748B"/>
                <TextBlock Text="{Binding TimeRemaining}" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text=" secondes" Foreground="#64748B"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="Rafraîchir" Command="{Binding RefreshCommand}" Width="120" Margin="0,0,10,0" Padding="8" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Fermer" Command="{Binding CancelAndCloseCommand}" Width="120" Padding="8" Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

