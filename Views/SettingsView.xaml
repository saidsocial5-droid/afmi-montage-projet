<UserControl x:Class="AFMI_Montage_projet_2.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:AFMI_Montage_projet_2.Converters"
             mc:Ignorable="d" 
             xmlns:helpers="clr-namespace:AFMI_Montage_projet_2.Helpers"
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Conversion pour FlowDirection Arabe -->
        <FlowDirection x:Key="RtlDirection">RightToLeft</FlowDirection>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- En-tête Global -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="25,15">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="⚙️ Paramètres de l'Application" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Gérez la configuration globale, l'apparence et l'IA de votre plateforme de montage de projets." Foreground="#64748B" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Contenu à Onglets -->
        <TabControl Grid.Row="1" Margin="15" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="15,10" Margin="0,0,5,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="5,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ONGLET : MISES À JOUR (ADR 29), visible par tous : chaque poste gère sa propre mise à jour -->
            <TabItem Header="🔄 Mises à jour">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,20,10,10" MaxWidth="760" HorizontalAlignment="Left">
                    <!-- Mises à jour (ADR 26) -->
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <Border.Effect><DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🔄 Mises à jour" FontWeight="Bold" Foreground="#1E293B" FontSize="15" Margin="0,0,0,8"/>
                            <TextBlock Foreground="#475569" FontSize="12" Margin="0,0,0,12">
                                <Run Text="Version installée :"/> <Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>

                            <!-- Mise à jour automatique (ADR 29) : le réglage principal, en tête de l'onglet -->
                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding AutoInstallUpdates}" FontSize="14" FontWeight="SemiBold" Foreground="#0C4A6E"
                                              Content="Activer la mise à jour automatique"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="22,6,0,0"
                                               Text="Au démarrage, la nouvelle version est téléchargée et vérifiée en arrière-plan. Vous pouvez l'installer tout de suite ; sinon elle s'installe toute seule à la fermeture du logiciel. Vos projets ne sont jamais touchés."/>
                                    <TextBlock Text="{Binding AutoInstallStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" TextWrapping="Wrap" Margin="22,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Dépôt GitHub des versions publiées (propriétaire/dépôt)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <Grid Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GitHubRepository, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" VerticalContentAlignment="Center"
                                         helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Identifiant technique de dépôt GitHub"/>
                                <Button Grid.Column="1" Content="Enregistrer" Command="{Binding SaveGitHubRepositoryCommand}" Margin="8,0,0,0" Padding="10,4" Cursor="Hand"/>
                            </Grid>
                            <!-- Clé d'accès : propre à chaque poste, donc saisissable par tout utilisateur (ADR 29) -->
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Text="Clé d'accès de ce poste (dépôt privé) : jeton GitHub « fine-grained » limité à ce dépôt, permission Contents en lecture seule. Chiffrée sur ce poste uniquement."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="TokenBox" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Enregistrer" Click="SaveToken_Click" Margin="8,0,0,0" Padding="10,4" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="Effacer" Command="{Binding ClearGitHubTokenCommand}" Margin="6,0,0,0" Padding="10,4" Cursor="Hand"/>
                                </Grid>
                                <TextBlock Text="{Binding GitHubTokenStatus}" FontSize="11" Foreground="#047857" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="Rechercher une mise à jour" Command="{Binding CheckGitHubUpdatesCommand}" Margin="0,10,0,0" Padding="12,7" HorizontalAlignment="Left"
                                    Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <TextBlock Text="{Binding UpdateStatus}" Foreground="#0369A1" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET : APPARENCE & TYPOGRAPHIE -->
            <TabItem Header="🎨 Apparence &amp; Typographie">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10,20,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Volet Gauche : Sélection -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">

                            <!-- Langue des réponses de l'IA (ADR 26) -->
                            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                                <Border.Effect><DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🌐 Langue des réponses de l'IA" FontWeight="Bold" Foreground="#1E293B" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="Si le modèle répond dans une autre langue, la réponse est traduite automatiquement. Clic droit sur tout texte ou Ctrl+Maj+T : traduction français · العربية · English."
                                               Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding ResponseLanguageOptions}" SelectedItem="{Binding SelectedResponseLanguage}" DisplayMemberPath="Label" Height="32"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                                <Border.Effect><DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Configuration des Polices" FontWeight="Bold" Foreground="#1E293B" FontSize="15" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="Police de l'interface (Sans-serif)" FontWeight="SemiBold" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableBaseFonts}" SelectedItem="{Binding SelectedBaseFont}" Height="35" Margin="0,0,0,15"/>

                                    <TextBlock Text="Police des Titres &amp; Documents (Serif)" FontWeight="SemiBold" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableHeadingFonts}" SelectedItem="{Binding SelectedHeadingFont}" Height="35" Margin="0,0,0,15"/>

                                    <TextBlock Text="Police Arabe (RTL)" FontWeight="SemiBold" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableArabicFonts}" SelectedItem="{Binding SelectedArabicFont}" Height="35" Margin="0,0,0,15"/>

                                    <TextBlock Text="Taille de texte globale" FontWeight="SemiBold" Foreground="#475569" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableFontSizes}" SelectedItem="{Binding SelectedFontSize}" Height="35" Margin="0,0,0,5"/>
                                </StackPanel>
                            </Border>

                            <Button Content="🔄 Rétablir les valeurs par défaut" Command="{Binding ResetTypographyDefaultsCommand}" 
                                    Height="35" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,5,0,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Volet Droit : Aperçu en direct -->
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="25" Margin="15,0,0,15">
                            <Border.Effect><DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Aperçu en direct" FontWeight="Bold" Foreground="#1E293B" FontSize="15" Margin="0,0,0,20"/>

                                <!-- Aperçu Titre -->
                                <TextBlock Text="Titre : Gestion des Projets Associatifs" 
                                           FontFamily="{Binding SelectedHeadingFont}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                
                                <!-- Aperçu Interface -->
                                <TextBlock Text="L'interface de l'application utilisera cette police pour garantir une lisibilité optimale sur tous les écrans, avec un contraste conforme aux normes d'accessibilité WCAG." 
                                           FontFamily="{Binding SelectedBaseFont}" FontSize="14" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="20"/>

                                <!-- Aperçu Arabe -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                                    <StackPanel FlowDirection="RightToLeft">
                                        <TextBlock Text="إدارة المشاريع الجمعوية (Aperçu RTL)" 
                                                   FontFamily="{Binding SelectedArabicFont}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                        <TextBlock Text="تم تصميم هذا النظام خصيصا لتسهيل إدارة وتتبع المشاريع التنموية والجمعوية بشكل فعال، مع دعم كامل للغة العربية والاتجاه من اليمين إلى اليسار." 
                                                   FontFamily="{Binding SelectedArabicFont}" FontSize="15" Foreground="#334155" TextWrapping="Wrap" LineHeight="24"/>
                                    </StackPanel>
                                </Border>

                                <!-- Composants factices -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Bouton Exemple" FontFamily="{Binding SelectedBaseFont}" FontSize="13" Padding="15,8" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <TextBlock Text="Montant : 1 250,00 DH" FontFamily="{Binding SelectedBaseFont}" FontSize="14" FontWeight="Medium" Foreground="#10B981" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET : PARAMÈTRES IA -->
            <TabItem Header="🤖 Paramètres IA (Hybride)" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10,20,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Volet Gauche -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                                <Border.Effect><DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Routage de l'Assistant IA" FontWeight="Bold" Foreground="#1E293B" FontSize="14" Margin="0,0,0,10"/>
                                                                        <RadioButton Content="Moteur Local (Ollama - Gratuit / Hors ligne)" IsChecked="{Binding UseLocalByDefault}" GroupName="EngineMode" FontSize="12" Margin="0,0,0,8"/>
                                    
                                    <StackPanel IsEnabled="{Binding UseLocalByDefault}" Margin="20,0,0,15">
                                        <TextBlock Text="Ollama URL (ex: http://localhost:11434)" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="URL de point de terminaison technique" Text="{Binding OllamaUrl}" Height="25" Margin="0,0,0,5" Padding="3"/>
                                        <TextBlock Text="Nom du Modèle Local (Optionnel, laisse vide pour détection auto)" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Nom technique du modèle" Text="{Binding OllamaModel}" Height="25" Padding="3"/>
                                    </StackPanel>
                                    <RadioButton Content="Moteur Cloud (API externe requise)" IsChecked="{Binding UseLocalByDefault, Converter={StaticResource InverseBooleanConverter}}" GroupName="EngineMode" FontSize="12" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                                <Border.Effect><DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Configuration Cloud" FontWeight="Bold" Foreground="#1E293B" FontSize="14" Margin="0,0,0,10"/>
                                    <CheckBox Content="J'autorise la connexion Cloud (Opt-in)" IsChecked="{Binding CloudOptInGranted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,15"/>

                                    <StackPanel IsEnabled="{Binding CloudOptInGranted}">
                                        <TextBlock Text="Fournisseur d'IA" FontSize="12" Margin="0,0,0,5"/>
                                        <ComboBox SelectedValue="{Binding SelectedProvider}" SelectedValuePath="Content" Height="30" Margin="0,0,0,12">
                                            <ComboBoxItem Content="Gemini"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Claude"/><ComboBoxItem Content="DeepSeek"/>
                                        </ComboBox>
                                        
                                        <TextBlock Text="Clé d'API (Chiffrée)" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Clé d'API chiffrée DPAPI - Risque de sécurité" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,12"/>
                                        
                                        <TextBlock Text="Modèle IA" FontSize="12" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" Height="30"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <!-- ONGLET : DOCUMENTS & EXPORTS -->
            <TabItem Header="📄 Documents &amp; Exports" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVis}}">
                <Border Background="White" CornerRadius="8" Padding="40" Margin="10,20,10,10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Configuration des Exports" FontSize="18" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Cette section permettra de configurer le logo, les en-têtes et les marges pour les PDF et documents Word." Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </TabItem>
                    <!-- ONGLET : SYNCHRONISATION CLOUD (GOOGLE DRIVE) -->
            <TabItem Header="☁ Espace de travail Cloud" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,20,10,10">
                        <!-- Bloc Connexion -->
                        <Border Background="White" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Color="#E2E8F0"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Connexion à Google Drive (OAuth 2.0)" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,15"/>
                                <TextBlock Text="Ces identifiants sont locaux et sécurisés par l'OS." Foreground="#64748B" FontSize="12" Margin="0,0,0,15"/>

                                <TextBlock Text="Client ID :" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Identifiant OAuth Google Client ID" Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,15"/>

                                <TextBlock Text="Client Secret :" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Secret OAuth Google Client Secret" Text="{Binding GoogleClientSecret, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Connecter Google Drive" Command="{Binding ConnectGoogleDriveCommand}" 
                                            Height="40" Padding="20,0" Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <TextBlock Text="{Binding CloudStatusMessage}" Foreground="#10B981" FontWeight="SemiBold" Margin="15,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bloc Configuration Espace (Admin) -->
                        <Border Background="White" CornerRadius="8" Padding="25" IsEnabled="{Binding IsCloudConnected}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Color="#E2E8F0"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Administration de l'espace" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,15"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Button Content="Initialiser le dossier racine" Command="{Binding InitializeWorkspaceCommand}" 
                                            Height="40" Padding="15,0" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <TextBlock Text="{Binding WorkspaceId, StringFormat='ID: {0}'}" Foreground="#64748B" Margin="15,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="#F1F5F9" Height="1" Margin="0,10,0,20"/>

                                <TextBlock Text="Inviter un collaborateur :" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding InviteEmail, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="35" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"/>
                                    <Button Content="Envoyer Invitation" Command="{Binding InviteMemberCommand}" 
                                            Height="35" Padding="15,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        
            <!-- ONGLET : APPAREILS MOBILES -->
            <TabItem Header="📱 Appareils Mobiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,20,10,10">
                        <Border Background="White" CornerRadius="8" Padding="25" Margin="0,0,0,15">
                            <Border.Effect><DropShadowEffect BlurRadius="10" Direction="-90" ShadowDepth="1" Color="#E2E8F0"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Associer un appareil mobile" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <TextBlock Text="Générez un QR Code, ouvrez l'app Android et scannez-le. Valide 2 minutes, usage unique." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,15"/>
                                <Button Content="📱 Générer un QR Code de couplage" Command="{Binding OpenPairingWindowCommand}" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="14,9" Cursor="Hand" HorizontalAlignment="Left">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Padding="25">
                            <Border.Effect><DropShadowEffect BlurRadius="10" Direction="-90" ShadowDepth="1" Color="#E2E8F0"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Appareils associés" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                                <ItemsControl ItemsSource="{Binding LinkedDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="5,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="📱" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                        <TextBlock Foreground="#64748B" FontSize="12"><Run Text="Couplé le : "/><Run Text="{Binding PairedAt, StringFormat='{}{0:dd/MM/yyyy à HH:mm}'}"/></TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="🗑 Révoquer" Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="10,6" Cursor="Hand"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Aucun appareil associé." Foreground="#94A3B8" FontStyle="Italic" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LinkedDevices.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Pied de page : Actions & Statut -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="25,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="💾 Appliquer &amp; Enregistrer" Command="{Binding SaveSettingsCommand}"
                            Width="220" Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>







