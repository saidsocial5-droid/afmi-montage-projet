<Window x:Class="AFMI_Montage_projet_2.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
        Title="Gestion des Membres et Rôles"
        Icon="/app_icon.ico"
        Height="600" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Window.DataContext>
        <viewmodels:UserManagementViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="👥 Gestion des Membres" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Modifiez les comptes utilisateurs, les droits administrateurs et réinitialisez les mots de passe." Foreground="#64748B" FontSize="12"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des membres -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Membres enregistrés" FontWeight="Bold" Foreground="#334155" FontSize="13" Margin="0,0,0,10"/>
                    <ListView ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Height="450"
                              SelectionChanged="ListView_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,5">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#64748B"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Background="#E2E8F0" CornerRadius="4" Padding="4,2" Margin="0,0,5,0">
                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#475569"/>
                                        </Border>
                                        <Border Background="#DBEAFE" CornerRadius="4" Padding="4,2" Margin="0,0,5,0">
                                            <TextBlock Text="{Binding Role}" FontSize="10" Foreground="#1E40AF"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="⭐ Administrateur système" FontSize="10" Foreground="#F59E0B" Visibility="{Binding IsSystemAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Panneau modification -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#E2E8F0" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Modifier l'utilisateur sélectionné" FontWeight="Bold" Foreground="#334155" FontSize="13" Margin="0,0,0,15"/>

                    <TextBlock Text="Nom d'utilisateur" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12"/>

                    <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12"/>

                    <TextBlock Text="Statut" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <ComboBox SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Content" Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12">
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Suspended"/>
                        <ComboBoxItem Content="Rejected"/>
                    </ComboBox>

                    <TextBlock Text="Rôle" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <ComboBox SelectedValue="{Binding SelectedRole}" SelectedValuePath="Content" Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12">
                        <ComboBoxItem Content="SuperAdmin"/>
                        <ComboBoxItem Content="Manager"/>
                        <ComboBoxItem Content="Contributor"/>
                        <ComboBoxItem Content="Reader"/>
                    </ComboBox>

                    <CheckBox Content="Administrateur système (accès total)" IsChecked="{Binding IsSystemAdmin}" Foreground="#1E293B" FontWeight="Medium" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="💾 Enregistrer" Command="{Binding SaveUserCommand}"
                                Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="12,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="🔑 Réinitialiser MDP" Command="{Binding ResetPasswordCommand}"
                                Background="#F59E0B" Foreground="White" FontWeight="Bold" Padding="12,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="🗑 Supprimer" Command="{Binding DeleteUserCommand}"
                                Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="12,8" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

