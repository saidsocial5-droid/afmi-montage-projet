<UserControl x:Class="AFMI_Montage_projet_2.Views.AiAssistantPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Montage_projet_2.Views"
             xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="350">

    <Border BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Background="#F8FAFC">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Bandeau supérieur -->
                <RowDefinition Height="50"/>
                <!-- Fil des discussions -->
                <RowDefinition Height="*"/>
                <!-- Chargement -->
                <RowDefinition Height="Auto"/>
                <!-- Champ de saisie -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Bandeau supérieur -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="🤖 Assistant IA : " FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                        <Border CornerRadius="4" Padding="6,2" Background="{Binding CurrentEngineColor}" VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock Text="{Binding CurrentEngineName}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Sélecteur de langue -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" 
                              Width="90" Height="25" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="11" 
                              ToolTip="Choisir la langue de réponse de l'IA" />

                    <Button Grid.Column="2" Content="Effacer" Command="{Binding ClearHistoryCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="11" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Fil des discussions -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ChatScrollViewer" Padding="10">
                <StackPanel>
                    <!-- Liste des messages -->
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,12" Background="{Binding BgColor}" MaxWidth="300" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Alignment}" Value="Right">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Sender}" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                                            <Button Grid.Column="1" Content="📋 Copier" Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#3B82F6" FontSize="10" Cursor="Hand"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Content}" FontSize="12" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Puces d'actions rapides contextuelles -->
                    <WrapPanel Margin="0,10,0,10" HorizontalAlignment="Center">
                        <Button Content="Définir un indicateur" Command="{Binding SendQuickActionCommand}" CommandParameter="Comment définir un bon indicateur pour un projet ?"
                                Margin="2" Padding="8,4" Background="#E0E7FF" Foreground="#4338CA" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                        <Button Content="Idées d'activités" Command="{Binding SendQuickActionCommand}" CommandParameter="Quelles activités puis-je proposer pour lutter contre le surpâturage ?"
                                Margin="2" Padding="8,4" Background="#E0E7FF" Foreground="#4338CA" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                        <Button Content="Éviter les risques" Command="{Binding SendQuickActionCommand}" CommandParameter="Quels sont les principaux risques dans un projet agricole ?"
                                Margin="2" Padding="8,4" Background="#E0E7FF" Foreground="#4338CA" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Indicateur de Chargement -->
            <Border Grid.Row="2" Padding="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Génération de réponse IA en cours..." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Champ de saisie -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="80" Height="40" Padding="5" VerticalContentAlignment="Top" Tag="Poser une question à l'IA...">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="Envoyer" Command="{Binding SendMessageCommand}" Height="40" Margin="5,0,0,0"
                            Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

