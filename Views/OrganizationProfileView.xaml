<UserControl x:Class="AFMI_Montage_projet_2.Views.OrganizationProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        
        <!-- Style pour les onglets -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Style des cartes de section -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Color="#E2E8F0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les labels de champs -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Style pour les descriptions sous les labels -->
        <Style x:Key="FieldHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Style des boutons d'enrichissement IA -->
        <Style x:Key="AiActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C7D2FE"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Contenu avec onglets -->
            <RowDefinition Height="*"/>
            <!-- Pied de page / Statut -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. En-tête principal -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="18,14" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Color="#CBD5E1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏛️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Profil de l'Association &amp; Capacités Institutionnelles" FontSize="19" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Border Background="#EEF2FF" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Fiche ONG Bailleurs" Foreground="#4338CA" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Définition, historique, réalisations, gouvernance et garanties fiduciaires de l'organisation pour les bailleurs de fonds." 
                               Foreground="#64748B" FontSize="12" Margin="32,4,0,0"/>
                </StackPanel>

                <!-- Boutons d'actions principaux -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Bouton Analyser Documents & Liens Web / Réseaux -->
                    <Button Content="📥 Analyser Docs &amp; Liens" Command="{Binding OpenSourceAnalysisCommand}"
                            Background="#0D9488" Foreground="White" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="Analyser des documents (PDF, Word, Excel) et liens web / réseaux sociaux pour enrichir le profil de l'Association">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Bouton NotebookLM -->
                    <Button Content="📓 NotebookLM" Command="{Binding OpenNotebookLmDialogCommand}"
                            Background="#1E1B4B" Foreground="White" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="Lier avec Google NotebookLM, exporter le pack de connaissances RAG et interroger le profil">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Bouton Audit IA -->
                    <Button Content="🛡️ Audit IA Bailleurs" Command="{Binding AuditProfileIaCommand}"
                            Background="#059669" Foreground="White" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Bouton Rédiger Déclaration IA -->
                    <Button Content="✨ Déclaration IA" Command="{Binding GenerateCapacityStatementIaCommand}"
                            Background="#0284C7" Foreground="White" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Bouton Synchroniser avec le projet actif -->
                    <Button Content="🔄 Injecter dans projet" Command="{Binding SyncToActiveProjectCommand}"
                            Background="#7C3AED" Foreground="White" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"
                            Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="Injecter les coordonnées et forces organisationnelles dans la fiche de cadrage du projet actif">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Bouton Exporter Word -->
                    <Button Content="📄 Word" Command="{Binding ExportWordCommand}"
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="10,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Bouton Exporter PDF -->
                    <Button Content="📑 PDF" Command="{Binding ExportPdfCommand}"
                            Background="#475569" Foreground="White" BorderThickness="0" Padding="10,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Bouton Sauvegarder -->
                    <Button Content="💾 Enregistrer" Command="{Binding SaveCommand}"
                            Background="#4338CA" Foreground="White" BorderThickness="0" Padding="14,8" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Contenu à onglets -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            
            <!-- ONGLET 1 : Identité & Statut Légal -->
            <TabItem Header="🏛️ Identité &amp; Statut">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Identité Juridique &amp; Coordonnées Officielles" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nom officiel de l'organisation" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding OrganizationName, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sigle / Acronyme" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Acronym, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Année de création" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding CreationDate, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Statut juridique &amp; Dahir régissant l'association" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding LegalStatus, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Numéro de récépissé / Agrément officiel" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Siège social / Ville &amp; Région" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Headquarters, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Adresse postale complète" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Téléphone officiel" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Courriel institutionnel (Email)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Site web officiel" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>
                            </Grid>

                            <!-- Réseaux Sociaux & Présence Web -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Page Facebook" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding FacebookUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Profil LinkedIn" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding LinkedInUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Compte X / Twitter" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding TwitterUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>
                            </Grid>

                            <!-- Carnet Google NotebookLM de l'Association -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="📓 Carnet Google NotebookLM de l'Association (URL)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding NotebookLmUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="🔗 Ouvrir NotebookLM" Command="{Binding OpenNotebookLmUrlCommand}"
                                        Background="#1E1B4B" Foreground="White" BorderThickness="0" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Bottom" Height="32">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                </Button>
                            </Grid>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Représentant légal (Président, Secrétaire Général, Directeur Exécutif)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LegalRepresentative, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET 2 : Vision, Mission & Objectifs -->
            <TabItem Header="🎯 Vision &amp; Objectifs">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Cadre Stratégique, Mission &amp; Ancrage Thématique" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                            <!-- Mission -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mission institutionnelle" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Mission" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Définition de la raison d'être de l'organisation et de son engagement auprès des populations locales." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding Mission, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Padding="6" Margin="0,0,0,14"/>

                            <!-- Vision -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Vision à long terme" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Vision" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="L'impact futur et la transformation territoriale visée à horizon 10-15 ans." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding Vision, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="6" Margin="0,0,0,14"/>

                            <!-- Valeurs -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Valeurs fondamentales &amp; Principes éthiques" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Valeurs" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Principes guidant l'action : transparence fiduciaire, inclusion du genre, équité territoriale, concertation." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding CoreValues, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="6" Margin="0,0,0,14"/>

                            <!-- Les 5 Grands Axes Stratégiques d'Intervention (AFMI) -->
                            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🌲" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Les 5 Grands Axes Stratégiques d'Intervention (Plan d'Action AFMI)" 
                                                       FontWeight="Bold" FontSize="13.5" Foreground="#14532D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="⚙️ Gérer les 5 Axes (Radar IA)" Command="{Binding OpenAxesConfigDialogCommand}"
                                                    Background="#065F46" Foreground="White" BorderThickness="0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0"
                                                    ToolTip="Ouvrir la configuration détaillée des 5 axes pour l'algorithme de ciblage IA des subventions">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Axes" 
                                                    Style="{StaticResource AiActionBtnStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Les 5 axes majeurs définis dans le plan stratégique : 1. Gouvernance concertée | 2. Gestion des ressources naturelles | 3. Énergie et habitat | 4. Diversification des revenus | 5. Communication et mise en réseau." 
                                               Foreground="#166534" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding StrategicAxes, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="190" Padding="8" Background="White"
                                             BorderBrush="#BBF7D0" FontSize="11.5" FontFamily="Segoe UI" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Objectifs stratégiques -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Objectifs stratégiques pluriannuels" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Objectifs" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Axes prioritaires d'intervention (ex: restauration écologique, résilience eau/climat, filières vertes)." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding StrategicObjectives, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" Padding="6" Margin="0,0,0,14"/>

                            <!-- Zones & Thématiques -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Zones géographiques d'intervention (1 par ligne)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="Provinces, parcs nationaux, bassins versants ou communes cibles." Style="{StaticResource FieldHintStyle}"/>
                                    <TextBox Text="{Binding GeographicZonesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Padding="6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pôles thématiques d'excellence (1 par ligne)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="Thèmes prioritaires utilisés pour le ciblage et le Radar des opportunités." Style="{StaticResource FieldHintStyle}"/>
                                    <TextBox Text="{Binding PreferredThemesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Padding="6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET 3 : Historique & Trajectoire -->
            <TabItem Header="📜 Trajectoire &amp; Historique">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Historique, Genèse &amp; Évolution Institutionnelle" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Historique" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Racontez la genèse de l'organisation, ses étapes fondatrices, ses partenariats initiaux et sa trajectoire de montée en puissance. Ce récit démontre aux évaluateurs la solidité et l'ancrage institutionnel de la structure." 
                                       Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding HistoryTrajectory, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="280" Padding="8" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET 4 : Réalisations & Bilan d'Impact -->
            <TabItem Header="🏆 Réalisations &amp; Impact">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Antécédents Opérationnels &amp; Bilan d'Impact (Track Record)" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                            <!-- Réalisations phares -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Réalisations majeures et projets phares accomplis" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Réalisations" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Programmes menés à bien, initiatives communautaires concrètes, infrastructures ou restaurations réussies." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding KeyAchievements, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="140" Padding="6" Margin="0,0,0,14"/>

                            <!-- Chiffres clés -->
                            <TextBlock Text="Chiffres clés consolidés d'impact" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="Indicateurs macro : nombre de bénéficiaires directs/indirects, hectares restaurés, coopératives créées, montants gérés." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding ImpactFigures, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,14"/>

                            <!-- Distinctions -->
                            <TextBlock Text="Reconnaissances, Prix &amp; Accréditations Internationales" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="Labels, prix d'excellence, affiliations à des réseaux internationaux (ex: Réseau des Forêts Modèles)." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding RecognitionsAwards, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Padding="6" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET 5 : Capacités Internes -->
            <TabItem Header="⚙️ Capacités &amp; Moyens">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Capacités Institutionnelles, Humaines &amp; Fiducières" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                            <!-- Ressources Humaines -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Ressources humaines &amp; Gouvernance opérationnelle" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="RessourcesHumaines" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Composition de l'équipe permanente, profils clés (Directeur, RAF, Ingénieurs, Suivi-Éval), conseil d'administration et comités consultatifs." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding HumanResourcesCapacity, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Padding="6" Margin="0,0,0,14"/>

                            <!-- Gestion Financière -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Capacité de gestion administrative &amp; financière (Garanties fiducières)" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="GestionFinanciere" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Système de comptabilité analytique, commissariat aux comptes, manuel de procédures, audits annuels sans réserve et procédure de double signature." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding FinancialManagementCapacity, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Padding="6" Margin="0,0,0,14"/>

                            <!-- Moyens Matériels -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Moyens matériels, techniques &amp; logistique de terrain" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="MoyensMateriels" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Locaux administratifs, parcs de véhicules tout-terrain, matériel SIG/GPS, salles de formation et équipement d'intervention." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding LogisticalMaterialCapacity, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" Padding="6" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET 6 : Expérience Bailleurs & Partenariats -->
            <TabItem Header="🤝 Bailleurs &amp; Partenaires">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Expérience des Financements Internationaux &amp; Références" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                            <!-- Bailleurs préférés -->
                            <TextBlock Text="Bailleurs de fonds partenaires (1 par ligne)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="Bailleurs multilatéraux et bilatéraux familiers des projets de l'association." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding PreferredDonorsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Padding="6" Margin="0,0,0,14"/>

                            <!-- Projets passés avec bailleurs -->
                            <TextBlock Text="Références détaillées de projets subventionnés menés à terme" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="Nom du projet, bailleur, budget alloué, années d'exécution et rôle (chef de file / porteur principal)." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding PastProjectsReferences, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="130" Padding="6" Margin="0,0,0,14"/>

                            <!-- Partenariats institutionnels -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Partenariats institutionnels &amp; Réseaux d'alliance" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Partenariats" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Collaborations avec ministères, universités, instituts de recherche et collectivités territoriales." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding StrategicPartnerships, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Padding="6" Margin="0,0,0,14"/>

                            <!-- Domaines d'expertise -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Domaines d'expertise technique &amp; méthodologique d'excellence" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Content="✨ Enrichir IA" Command="{Binding EnrichSectionIaCommand}" CommandParameter="Expertise" 
                                        Style="{StaticResource AiActionBtnStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Savoir-faire distinctif de l'organisation reconnu par la communauté des bailleurs." Style="{StaticResource FieldHintStyle}"/>
                            <TextBox Text="{Binding TechnicalExpertiseSummary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Padding="6" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET 7 : Déclaration de Capacité (Capacity Statement) -->
            <TabItem Header="📄 Déclaration de Capacité">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Déclaration de Capacité Institutionnelle (Capacity Statement)" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                    <TextBlock Text="Texte synthétique calibré pour les formulaires de candidature et les sections 'Capacité du demandeur' des bailleurs de fonds." Style="{StaticResource FieldHintStyle}"/>
                                </StackPanel>

                                <!-- Sélecteur de bailleur et déclencheur IA -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Bailleur ciblé :" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#475569"/>
                                    <ComboBox ItemsSource="{Binding AvailableDonors}" SelectedItem="{Binding SelectedDonor}" Width="210" Height="32" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                    <Button Content="✨ Rédiger par IA" Command="{Binding GenerateCapacityStatementIaCommand}"
                                            Background="#0284C7" Foreground="White" BorderThickness="0" Padding="12,6" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="📋 Copier" Command="{Binding CopyCapacityStatementCommand}"
                                            Background="#334155" Foreground="White" BorderThickness="0" Padding="10,6" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F1F5F9" CornerRadius="6" Padding="10" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#CBD5E1">
                                <TextBlock Text="💡 Astuce Bailleurs : Ce texte résume en quelques paragraphes percutants la légitimité, la garantie fiduciaire, l'ancrage territorial et la compétence technique de votre association. Vous pouvez le régénérer pour chaque bailleur afin d'adapter l'argumentaire à ses priorités spécifiques." 
                                           Foreground="#334155" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>

                            <TextBox Text="{Binding DonorCapacityStatement, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="300" Padding="10" FontSize="12.5" 
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ONGLET 8 : Sources & Google NotebookLM -->
            <TabItem Header="🌐 Sources &amp; NotebookLM">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- CARTE 1 : Analyse IA de Documents & Liens Web / Réseaux Sociaux -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📥" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Analyse IA de Documents &amp; Liens Web / Réseaux Sociaux" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                            <Border Background="#ECFDF5" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Auto-enrichissement" Foreground="#059669" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Importez vos rapports d'activités, bilans financiers, conventions ou URLs de réseaux sociaux pour extraire et fusionner automatiquement les données dans le profil." 
                                                   Style="{StaticResource FieldHintStyle}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="🚀 Ouvrir l'Analyseur de Sources" Command="{Binding OpenSourceAnalysisCommand}"
                                            Background="#0D9488" Foreground="White" BorderThickness="0" Padding="14,8" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Historique des sources analysées :" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" MinHeight="70" MaxHeight="140">
                                    <ListBox ItemsSource="{Binding AnalyzedSourcesHistory}" Background="Transparent" BorderThickness="0" Padding="6">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="📄 " Foreground="#0D9488"/>
                                                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#334155"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARTE 2 : Intégration Google NotebookLM -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📓" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Liaison Google NotebookLM (Base de Connaissances &amp; RAG)" FontSize="15" FontWeight="Bold" Foreground="#1E1B4B"/>
                                            <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Google AI Studio" Foreground="#4338CA" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Liez l'association à votre carnet NotebookLM, exportez le pack source institutionnel (Markdown, PDF) et posez vos questions d'évaluation." 
                                                   Style="{StaticResource FieldHintStyle}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="📓 Studio &amp; Prompts NotebookLM" Command="{Binding OpenNotebookLmDialogCommand}"
                                            Background="#1E1B4B" Foreground="White" BorderThickness="0" Padding="14,8" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>

                                <!-- Configuration directe URL NotebookLM -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="URL du Carnet NotebookLM :" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding NotebookLmUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="🌐 Ouvrir dans le Navigateur" Command="{Binding OpenNotebookLmUrlCommand}"
                                            Background="#4338CA" Foreground="White" BorderThickness="0" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Bottom" Height="32">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                </Grid>

                                <!-- Boutons d'export rapide du pack source -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="📋 Copier la Source (Texte pour NotebookLM)" Command="{Binding CopyNotebookLmSourceCommand}"
                                            Background="#059669" Foreground="White" BorderThickness="0" Padding="12,7" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="💾 Exporter le Pack Source (.md / .pdf)" Command="{Binding ExportNotebookLmSourceCommand}"
                                            Background="#0284C7" Foreground="White" BorderThickness="0" Padding="12,7" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 3. Pied de page / Barre de statut -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ " FontSize="12"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12" FontWeight="Medium"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Fichier de configuration : afmi_profile.json" Foreground="#94A3B8" FontSize="11" Margin="0,0,15,0"/>
                    <Button Content="🔄 Recharger" Command="{Binding ReloadCommand}" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0"/>
                    <Button Content="⚙️ Valeurs d'origine AFMI" Command="{Binding ResetDefaultCommand}" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
