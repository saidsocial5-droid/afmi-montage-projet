<UserControl x:Class="AFMI_Montage_projet_2.Views.ArbreProblemeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Arborescence -->
        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Arbre de Problèmes" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Initialiser le Problème Central" Command="{Binding AddCoreProblemCommand}" 
                            Background="#0284C7" Foreground="White" Padding="8,4" BorderThickness="0" Cursor="Hand" />
                </Grid>

                <TreeView x:Name="MyTreeView" Grid.Row="2" ItemsSource="{Binding RootNodes}" Background="Transparent" BorderThickness="0">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding ChildNodes}">
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <!-- Badge de statut -->
                                <Border CornerRadius="3" Padding="4,2" Margin="0,0,5,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#FEF08A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="9" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓"/>
                                                <Setter Property="Foreground" Value="#166534"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Text" Value="🟡"/>
                                                        <Setter Property="Foreground" Value="#854D0E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                
                                <TextBlock Text="{Binding NodeType}" FontWeight="Bold" Foreground="#64748B" Margin="0,0,5,0" />
                                <TextBlock Text=" : " />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#334155" />

                                <!-- Auteur -->
                                <TextBlock FontSize="10" Foreground="#94A3B8" Margin="5,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ProposedByUser.Username, StringFormat='(par @{0})'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnonymized}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ProposedByUser}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>

        <!-- Détails du noeud sélectionné -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid DataContext="{Binding SelectedItem, ElementName=MyTreeView}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=MyTreeView, Path=SelectedItem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Édition du Nœud" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />

                <Grid Grid.Row="2" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Titre :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="✨ Assistant IA :" VerticalAlignment="Center" Foreground="#0284C7" FontWeight="Bold" FontSize="11" Margin="0,0,10,0"/>
                        <Button Content="📝 Enrichir" Command="{Binding DataContext.AiEnrichTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="Enrichir le titre avec le contexte du projet"/>
                        <Button Content="🔄 Reformuler" Command="{Binding DataContext.AiReformulateTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="Reformuler le titre pour qu'il soit plus percutant"/>
                        <Button Content="Suggérer" Command="{Binding DataContext.AiSuggestTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="L'IA génère des propositions de titre (problème négatif)"/>
                        <Button Content="Corriger" Command="{Binding DataContext.AiCorrectTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" ToolTip="Corriger l'orthographe du titre"/>
                    </StackPanel>
                </Grid>
                <TextBox Grid.Row="3" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14" />

                <Grid Grid.Row="5" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="✨ Assistant IA :" VerticalAlignment="Center" Foreground="#0284C7" FontWeight="Bold" FontSize="11" Margin="0,0,10,0"/>
                        <Button Content="📝 Enrichir" Command="{Binding DataContext.AiEnrichCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="Enrichir la description avec le contexte du projet"/>
                        <Button Content="🔄 Reformuler" Command="{Binding DataContext.AiReformulateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="Reformuler la description pour qu'elle soit plus claire et professionnelle"/>
                        <Button Content="🔍 Détailler" Command="{Binding DataContext.AiDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="Détailler la description"/>
                        <Button Content="Générer" Command="{Binding DataContext.AiGenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="Générer automatiquement une description à partir du titre"/>
                        <Button Content="Corriger" Command="{Binding DataContext.AiCorrectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="Corriger l'orthographe et la grammaire"/>
                        <Button Content="Analyser" Command="{Binding DataContext.AiAnalyzeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,10,0" ToolTip="Analyser le problème pour donner des pistes d'orientation"/>
                        <Button Content="Suggérer" Command="{Binding DataContext.AiSuggestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontSize="11" ToolTip="Suggérer des causes et conséquences probables"/>
                    </StackPanel>
                </Grid>
                <TextBox Grid.Row="6" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" />

                <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Actions Admin -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="✓ Approuver" 
                                Command="{Binding DataContext.ApproveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="8,4" Margin="0,0,5,0" />
                        <Button Content="✓👻 Approuver &amp; Anonymiser" 
                                Command="{Binding DataContext.ApproveAndAnonymizeNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="8,4" />
                    </StackPanel>

                    <Button Content="Supprimer" Command="{Binding DataContext.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}" Background="#EF4444" Foreground="White" Padding="12,6" Margin="0,0,10,0" BorderThickness="0" />
                    <Button Content="Ajouter une Cause" Command="{Binding DataContext.AddCauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}" Background="#F59E0B" Foreground="White" Padding="12,6" Margin="0,0,10,0" BorderThickness="0" />
                    <Button Content="Ajouter une Conséquence" Command="{Binding DataContext.AddConsequenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}" Background="#8B5CF6" Foreground="White" Padding="12,6" Margin="0,0,10,0" BorderThickness="0" />
                    <Button Content="Sauvegarder" Command="{Binding DataContext.SaveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}" Background="#10B981" Foreground="White" Padding="12,6" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- On ajoute le Name "MyTreeView" dynamiquement depuis le code-behind ou en bindant SelectedNode,
             mais WPF TreeView ne bind pas SelectedItem facilement. On va contourner avec Event Trigger dans le code behind. -->
    </Grid>
</UserControl>

