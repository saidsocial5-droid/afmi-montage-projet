<Window x:Class="AFMI_Montage_projet_2.Views.ProfileSourceAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
        mc:Ignorable="d"
        Title="Analyse IA de Documents &amp; Liens Web / Réseaux Sociaux (Individuelle &amp; Globale)" 
        Height="820" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Contenu (Onglets) -->
            <RowDefinition Height="*"/>
            <!-- 2: Pied de page / Statut -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. En-tête -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧠" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Analyse de Documents &amp; Liens Web / Réseaux Sociaux" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#ECFDF5" CornerRadius="12" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Analyse Unitaire &amp; Globale" Foreground="#059669" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Analysez chaque document ou lien individuellement pour cibler son apport précis, ou lancez une analyse globale combinée." 
                               Foreground="#64748B" FontSize="12" Margin="32,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="✕ Fermer" Click="CloseButton_Click" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Contenu principal (Onglets : 1. Sources | 2. Propositions d'enrichissement) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">

            <!-- ONGLET 1 : Sources documentaires et web -->
            <TabItem Header="📥 1. Sélection des Sources &amp; Analyse Unitaire">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Deux colonnes de sources : Fichiers vs Liens Web / Réseaux -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLONNE GAUCHE : Documents locaux -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="📁 Documents Institutionnels Locaux" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Rapports d'activité, bilans financiers, statuts, fiches projets (PDF, Word, Excel, TXT)." Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
                                </StackPanel>

                                <Button Grid.Row="1" Content="➕ Ajouter des Documents..." Command="{Binding BrowseFilesCommand}"
                                        Background="#0284C7" Foreground="White" BorderThickness="0" Padding="10,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,10">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>

                                <!-- Liste des documents avec action unitaire -->
                                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <ListBox ItemsSource="{Binding Documents}" Background="Transparent" BorderThickness="0" Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Ligne 1 : Nom, taille, statut badge et bouton suppression -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#1E293B" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FileSizeText}" Foreground="#94A3B8" FontSize="10"/>
                                                            </StackPanel>

                                                            <!-- Badge de statut -->
                                                            <Border Grid.Column="2" Background="{Binding StatusBadgeBackground}" CornerRadius="10" Padding="6,2" Margin="4,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                                            </Border>

                                                            <Button Grid.Column="3" Content="✕" 
                                                                    Command="{Binding DataContext.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Padding="4,0"
                                                                    ToolTip="Retirer ce document"/>
                                                        </Grid>

                                                        <!-- Ligne 2 : Actions unitaires (⚡ Analyser ce document seul | 👁️ Aperçu du texte) -->
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0" Content="⚡ Analyser ce document" 
                                                                    Command="{Binding DataContext.AnalyzeSingleDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#0284C7" Foreground="White" BorderThickness="0" Padding="8,4" FontWeight="SemiBold" FontSize="11" Cursor="Hand" Margin="0,0,4,0">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                            </Button>

                                                            <Button Grid.Column="1" Content="👁️ Aperçu" 
                                                                    Command="{Binding DataContext.PreviewSourceTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand"
                                                                    ToolTip="Voir le texte extrait du document"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- COLONNE DROITE : Liens Web & Réseaux Sociaux + Texte collé -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="160"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="🌐 Liens Web, Articles &amp; Réseaux Sociaux" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Site officiel, Facebook, LinkedIn, Twitter, articles de presse." Foreground="#64748B" FontSize="11" Margin="0,0,0,6"/>
                                </StackPanel>

                                <!-- Raccourcis Presets Réseaux Sociaux -->
                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                    <Button Content="📘 Facebook" Command="{Binding AddQuickPresetCommand}" CommandParameter="Facebook"
                                            Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,3" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,4,4">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="💼 LinkedIn" Command="{Binding AddQuickPresetCommand}" CommandParameter="LinkedIn"
                                            Background="#EEF2FF" Foreground="#4338CA" BorderBrush="#C7D2FE" BorderThickness="1" Padding="8,3" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,4,4">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="🐦 X / Twitter" Command="{Binding AddQuickPresetCommand}" CommandParameter="Twitter"
                                            Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,3" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,4,4">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="🎥 YouTube" Command="{Binding AddQuickPresetCommand}" CommandParameter="YouTube"
                                            Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="8,3" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,4,4">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="🌐 Site officiel" Command="{Binding AddQuickPresetCommand}" CommandParameter="Website"
                                            Background="#ECFDF5" Foreground="#047857" BorderBrush="#A7F3D0" BorderThickness="1" Padding="8,3" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,4,4">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </WrapPanel>

                                <!-- Saisie d'une URL -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewUrlInput, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" FontSize="12" Margin="0,0,6,0" ToolTip="Entrez une URL (ex: lien d'article ou publication)"/>
                                    <Button Grid.Column="1" Content="Ajouter Lien" Command="{Binding AddWebUrlCommand}"
                                            Background="#0D9488" Foreground="White" BorderThickness="0" Padding="10,6" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>

                                <!-- Liste des Liens Web avec actions unitaires -->
                                <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,8">
                                    <ListBox ItemsSource="{Binding Links}" Background="Transparent" BorderThickness="0" Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="6" Padding="8,6" Margin="0,0,0,4" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Titre, URL, Badge et Suppression -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#1E293B" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding PathOrUrl}" Foreground="#0284C7" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <Border Grid.Column="2" Background="{Binding StatusBadgeBackground}" CornerRadius="10" Padding="6,2" Margin="4,0,4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                                            </Border>

                                                            <Button Grid.Column="3" Content="✕" 
                                                                    Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Padding="4,0"/>
                                                        </Grid>

                                                        <!-- Actions unitaires du lien (⚡ Analyser | 👁️ Aperçu | 🌐 Ouvrir) -->
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,0,0">
                                                            <Button Content="⚡ Analyser ce lien" 
                                                                    Command="{Binding DataContext.AnalyzeSingleLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#0D9488" Foreground="White" BorderThickness="0" Padding="8,3" FontWeight="SemiBold" FontSize="10.5" Cursor="Hand" Margin="0,0,4,0">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                            </Button>

                                                            <Button Content="👁️ Aperçu" 
                                                                    Command="{Binding DataContext.PreviewSourceTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6,3" FontSize="10.5" Cursor="Hand" Margin="0,0,4,0"/>

                                                            <Button Content="🌐 Ouvrir" 
                                                                    Command="{Binding DataContext.OpenLinkInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#F1F5F9" Foreground="#4338CA" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6,3" FontSize="10.5" Cursor="Hand"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Texte brut collé (Publications, posts réseaux sociaux) -->
                                <TextBlock Grid.Row="4" Text="📝 Ou coller un extrait de publication / post réseau social :" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,3"/>
                                <TextBox Grid.Row="5" Text="{Binding PastedText, UpdateSourceTrigger=PropertyChanged}" 
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                         Padding="8" FontSize="11" Background="#F8FAFC" BorderBrush="#CBD5E1" MinHeight="60"
                                         ToolTip="Collez ici le texte d'un post Facebook, d'une annonce LinkedIn ou d'un compte-rendu."/>

                                <!-- Bouton pour analyser l'extrait seul -->
                                <Button Grid.Row="6" Content="⚡ Analyser cet extrait textuel" Command="{Binding AnalyzePastedTextCommand}"
                                        Background="#4338CA" Foreground="White" BorderThickness="0" Padding="8,5" FontWeight="SemiBold" FontSize="11" Cursor="Hand" Margin="0,4,0,0" HorizontalAlignment="Right">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Barre inférieure : Analyse Globale & Focus -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14,10" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Focus d'analyse optionnel :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0" FontSize="12"/>
                                <TextBox Text="{Binding UserFocus, UpdateSourceTrigger=PropertyChanged}" Width="380" Padding="6,4" FontSize="12"
                                         ToolTip="Ex: Insister sur les coopératives féminines, les budgets gérés ou le partenariat avec le PNUD"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🚀 Analyser Toutes les Sources (Analyse Globale)" Command="{Binding LaunchGlobalAnalysisCommand}"
                                    IsEnabled="{Binding IsAnalyzing, Converter={x:Null}}"
                                    Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="18,10" FontWeight="Bold" FontSize="13" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ONGLET 2 : Résultats & Propositions d'amélioration -->
            <TabItem Header="✨ 2. Propositions d'Amélioration Détectées">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barre d'outils : Filtrage par Source & Sélection -->
                    <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Filtrer par source :" FontWeight="SemiBold" Foreground="#334155" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceFilterOptions}" SelectedItem="{Binding SelectedSourceFilter}" 
                                      Width="280" Height="30" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding FilteredProposals.Count, StringFormat='Affichage : {0} proposition(s)'}" 
                                       Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="☑️ Tout cocher" Command="{Binding SelectAllCommand}" Background="Transparent" Foreground="#4F46E5" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                <Button Content="⬜ Tout décocher" Command="{Binding DeselectAllCommand}" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Liste des propositions d'enrichissement -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredProposals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Color="#E2E8F0"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Ligne 0 : En-tête de la proposition -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding FieldDisplayName}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                    <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                    </Border>
                                                    <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MergeModeDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4338CA"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Source : " FontSize="11" Foreground="#94A3B8"/>
                                                            <TextBlock Text="{Binding SourceOrigin}" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Ligne 1 : Comparaison Avant / Après (Actuelle vs Suggérée) -->
                                            <Grid Grid.Row="1" Margin="24,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Valeur actuelle -->
                                                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" Padding="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Valeur actuelle dans le profil :" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding CurrentValue}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" MaxHeight="100"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Proposition IA -->
                                                <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="6" Padding="8" BorderBrush="#A7F3D0" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="✨ Suggestion issue de la source :" FontSize="10.5" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding SuggestedValue, UpdateSourceTrigger=PropertyChanged}" 
                                                                 AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                                                 FontSize="11.5" Foreground="#064E3B" FontWeight="Medium"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Ligne 2 : Justification / Intérêt pour les bailleurs -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,4,0,0">
                                                <TextBlock Text="💡 Intérêt bailleur : " FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock Text="{Binding Rationale}" FontSize="11" FontStyle="Italic" Foreground="#64748B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Ligne 2 : Bouton d'application -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14,10" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Les modifications appliquées viendront actualiser les champs du profil de l'Association." Foreground="#64748B" FontSize="11.5"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="✅ Appliquer les modifications sélectionnées au Profil" 
                                    Command="{Binding ApplySelectedProposalsCommand}"
                                    Background="#059669" Foreground="White" BorderThickness="0" Padding="18,10" FontWeight="Bold" FontSize="13" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 2. Pied de page / Barre de statut & Progression -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12,8" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="14" Margin="0,0,10,0"
                                 Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisConverter}}"/>
                    <TextBlock Text="ℹ️ " FontSize="12"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12" FontWeight="Medium"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Moteur d'analyse : IA Multi-modèle AFMI" Foreground="#94A3B8" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- OVERLAY MODAL : Prévisualisation du Texte Brut Extrait -->
        <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="White" CornerRadius="8" Width="750" Height="550" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Direction="-90" ShadowDepth="4" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PreviewTitle}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                        <Button Grid.Column="1" Content="✕" Command="{Binding ClosePreviewCommand}" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="14"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
                        <TextBox Text="{Binding PreviewContent}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontFamily="Consolas, Segoe UI" FontSize="11"/>
                    </Border>

                    <Button Grid.Row="2" Content="Fermer l'aperçu" Command="{Binding ClosePreviewCommand}" 
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
