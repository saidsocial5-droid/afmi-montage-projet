<UserControl x:Class="AFMI_Montage_projet_2.Views.CloudSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Montage_projet_2.Converters"
             xmlns:helpers="clr-namespace:AFMI_Montage_projet_2.Helpers"
             mc:Ignorable="d" 
             Background="White">
    <UserControl.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="☁️ Synchronisation Cloud (PostgreSQL)" FontSize="24" FontWeight="Bold" Foreground="#1E293B" />
                <TextBlock Text="Configurez une base de données distante pour collaborer en temps réel avec votre équipe." Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Configuration -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Identifiants du Serveur (ex: Supabase, Azure, AWS)" FontWeight="Bold" FontSize="16" Foreground="#334155" />

                    <!-- Activer le mode Cloud -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Activer le mode Cloud :" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Settings.UseCloud}" VerticalAlignment="Center" />

                    <!-- Host -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Serveur (Host) :" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Row="4" Grid.Column="1" helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Adresse réseau du serveur" Text="{Binding Settings.Host}" Padding="5" />

                    <!-- Port & Database -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Port &amp; Nom de la DB :" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Grid Grid.Row="6" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Port réseau" Text="{Binding Settings.Port}" Padding="5" />
                        <TextBox Grid.Column="2" helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Nom technique de la base" Text="{Binding Settings.Database}" Padding="5" />
                    </Grid>

                    <!-- Identifiants -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Utilisateur &amp; Mot de passe :" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Grid Grid.Row="8" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" helpers:AiTextAssistant.IsExcluded="True" helpers:AiTextAssistant.ExclusionReason="Identifiant de connexion" Text="{Binding Settings.Username}" Padding="5" />
                        <!-- PasswordBox : n'hérite pas de TextBoxBase, donc jamais exposé à l'assistant IA. Synchronisé dans le code-behind. -->
                        <PasswordBox Grid.Column="2" x:Name="DbPasswordBox" PasswordChanged="DbPasswordBox_PasswordChanged" Padding="5" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Actions de Test -->
            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Button Content="💾 Enregistrer la configuration" Command="{Binding SaveSettingsCommand}" 
                        Background="#3B82F6" Foreground="White" Padding="15,10" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" FontWeight="Bold"/>
                
                <Button Content="🔌 Tester la connexion" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                        Background="#10B981" Foreground="White" Padding="15,10" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>

            <TextBlock Grid.Row="5" Text="{Binding ConnectionStatus}" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap" />

            <!-- Migration -->
            <Border Grid.Row="6" Background="#FFFBEB" CornerRadius="8" Padding="20" BorderBrush="#FCD34D" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Transfert des données existantes" FontSize="16" FontWeight="Bold" Foreground="#B45309" />
                    <TextBlock Text="Si vous venez de configurer un nouveau serveur Cloud vide, vous pouvez transférer vos projets locaux actuels vers celui-ci. Attention, le processus peut prendre quelques minutes." Foreground="#92400E" Margin="0,5,0,15" TextWrapping="Wrap"/>
                    
                    <Button Content="🚀 Migrer mes données locales vers le Cloud" Command="{Binding MigrateDataCommand}" IsEnabled="{Binding IsMigrating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                            Background="#F59E0B" Foreground="White" Padding="15,10" BorderThickness="0" Cursor="Hand" FontWeight="Bold" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

