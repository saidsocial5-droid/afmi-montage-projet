<Window x:Class="AFMI_Montage_projet_2.Views.IdeationInnovationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:AFMI_Montage_projet_2.ViewModels"
        Title="Laboratoire d'Innovation &amp; Brainstorming" Height="650" Width="900"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" Icon="/app_icon.ico">
    
    <Window.DataContext>
        <viewmodels:IdeationInnovationViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🚀 Idéation &amp; Amélioration de Projets" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Sélectionnez un projet en cours de montage pour que l'IA l'analyse (avec ses documents) et s'inspire du Web pour proposer des innovations." Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Sélection et Génération -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Projet à améliorer :" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Title" Height="35" Padding="5" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✨ Générer des améliorations (Web + Docs)" Command="{Binding GenerateIdeasAsync}" 
                        Background="#8B5CF6" Foreground="White" FontWeight="Bold" Padding="15,0" Height="35" VerticalAlignment="Bottom" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Résultats de l'IA -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Titre -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IntegrateTitle}" Content="Mettre à jour le Titre" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GeneratedTitle, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Contexte -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IntegrateContext}" Content="Mettre à jour le Contexte et la Justification" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GeneratedContext, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontSize="13" MinHeight="80"/>
                        </StackPanel>
                    </Border>

                    <!-- Objectif -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IntegrateObjective}" Content="Mettre à jour l'Objectif Général" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GeneratedObjective, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontSize="13" MinHeight="60"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Barre de statut et Validation -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>

            <Button Grid.Column="1" Content="V Valider et Intégrer les éléments choisis" Command="{Binding IntegrateIdeasCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Background="#10B981" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>

