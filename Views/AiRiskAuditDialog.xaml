<Window x:Class="AFMI_Montage_projet_2.Views.AiRiskAuditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit &amp; Diagnostic IA — Matrice des Risques" 
        Height="650" Width="850"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterOwner" 
        Background="#F8FAFC"
        FontFamily="Segoe UI, Roboto, Arial, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Contenu du rapport -->
            <RowDefinition Height="*"/>
            <!-- Pied de page -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. En-tête -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Rapport d'Audit &amp; Diagnostic de la Matrice des Risques" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Évaluation de la criticité, de la couverture sectorielle et de la robustesse des plans d'atténuation pour les bailleurs de fonds." 
                               Foreground="#94A3B8" FontSize="12" Margin="30,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Contenu du rapport -->
        <Border Grid.Row="1" Background="White" Margin="15" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">
            <TextBox x:Name="TxtAuditContent" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                     FontSize="13" Foreground="#1E293B"/>
        </Border>

        <!-- 3. Pied de page -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtCopyNotice" Text="💡 Ce rapport peut être directement copié pour enrichir la note d'analyse des risques de votre projet." 
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📋 Copier le rapport" Click="BtnCopy_Click" 
                            Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#CBD5E1" BorderThickness="1" 
                            Padding="16,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Fermer" Click="BtnClose_Click" 
                            Background="#0284C7" Foreground="White" BorderThickness="0" 
                            Padding="20,8" Cursor="Hand" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
